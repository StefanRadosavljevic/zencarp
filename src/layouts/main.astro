---
interface Props {
  title?: string
  description?: string
  navLinks?: Array<{ label: string; href: string }>
  cta?: { label: string; href: string }
}

const BASE = import.meta.env.BASE_URL
import "@/styles/global.css"

const fontHeading = "font-[family-name:var(--font-poppins)]"
const fontBody = "font-[family-name:var(--font-inter)]"

// --- NAVBAR DATA MOVED HERE ---
const defaultNavLinks = [
  { label: "Početna", href: BASE },
  { label: "Takmicari", href: `${BASE}competitors` },
  { label: "Jezero", href: `${BASE}lake` },
  { label: "Partneri", href: `${BASE}partners` },
  { label: "Pravilnik", href: `${BASE}rules` },
  { label: "Plasman", href: `${BASE}results` },
]

const defaultCta = { label: "Prijavi ekipu", href: "#enter" }

const {
  title = "ZenCarp",
  description = "4 tima. 4 sata. Jedan pobednik nosi sve.",
  navLinks = defaultNavLinks,
  cta = defaultCta,
} = Astro.props
---

<!doctype html>
<html lang="sr" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${BASE}favicon.svg`} />
    <title>{title}</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Oswald:wght@400;500;600;700&family=Poppins:wght@400;500;600;700;800&family=Source+Serif+4:ital,opsz,wght@0,8..60,300..700;1,8..60,300..700&display=swap"
      rel="stylesheet"
    />

    <style is:global>
      :root {
        --font-inter: "Inter", sans-serif;
        --font-poppins: "Poppins", sans-serif;
        --font-oswald: "Oswald", sans-serif;
        --font-source-serif: "Source Serif 4", serif;
      }
    </style>
  </head>
  <body class="bg-[#060a06] text-[#e8e8e8] antialiased">
    <!-- Header -->
    <header
      class="fixed top-0 z-50 w-full border-b border-[#111a11] bg-[#060a06]/90 backdrop-blur"
    >
      <div
        class="mx-auto flex max-w-6xl items-center justify-between px-5 py-3"
      >
        <a href={BASE} class="flex shrink-0 items-center">
          <img
            src={`${BASE}zencarp_logo.png`}
            alt="ZenCarp"
            class="h-10 w-auto"
          />
        </a>

        <nav class="hidden items-center gap-1 md:flex">
          {
            navLinks.map((l) => (
              <a
                href={l.href}
                class="rounded-lg px-3 py-1.5 text-sm text-[#aaa] transition-colors hover:text-[#f0f0f0]"
              >
                {l.label}
              </a>
            ))
          }

          <a
            href={cta.href}
            class={`ml-3 rounded-full bg-[#c9a227] px-4 py-1.5 text-sm font-medium text-[#0a0f0a] transition-colors hover:bg-[#d4b43a] ${fontHeading}`}
          >
            {cta.label}
          </a>
        </nav>

        <button
          id="mobile-menu-btn"
          class="flex h-9 w-9 items-center justify-center rounded-lg text-[#aaa] md:hidden"
          aria-label="Meni"
        >
          <svg
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <path d="M4 8h16M4 16h16"></path>
          </svg>
        </button>
      </div>

      <!-- Mobilni meni -->
      <div
        id="mobile-menu"
        class="hidden border-t border-[#111a11] bg-[#060a06] px-5 pt-2 pb-4 md:hidden"
      >
        {
          navLinks.map((l) => (
            <a
              href={l.href}
              class="block rounded-lg px-3 py-2 text-sm text-[#aaa] hover:text-[#f0f0f0]"
            >
              {l.label}
            </a>
          ))
        }

        <a
          href={cta.href}
          class={`mt-2 block rounded-lg bg-[#c9a227] px-3 py-2 text-center text-sm font-medium text-[#0a0f0a] ${fontHeading}`}
        >
          {cta.label}
        </a>
      </div>
    </header>

    <!-- Glavni sadržaj -->
    <main class="pt-16">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="border-t border-[#111a11] bg-[#060a06] px-5 py-10">
      <div
        class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-4 sm:flex-row"
      >
        <a href={BASE}>
          <img
            src={`${BASE}zencarp_logo.png`}
            alt="ZenCarp"
            class="h-8 w-auto"
          />
        </a>
        <p class="text-xs text-[#444]">© 2026 ZenCarp. Sva prava zadržana.</p>
        <div class="flex gap-4">
          <a
            href="#"
            class="text-xs text-[#555] transition-colors hover:text-[#c9a227]"
            >Instagram</a
          >
          <a
            href="#"
            class="text-xs text-[#555] transition-colors hover:text-[#c9a227]"
            >YouTube</a
          >
          <a
            href={`${BASE}pravilnik`}
            class="text-xs text-[#555] transition-colors hover:text-[#c9a227]"
            >Pravilnik</a
          >
        </div>
      </div>
    </footer>

    <!-- JavaScript za mobilni meni -->
    <script>
      ;(function () {
        const btn = document.getElementById("mobile-menu-btn")
        const menu = document.getElementById("mobile-menu")
        if (!btn || !menu) return

        btn.addEventListener("click", () => {
          const isHidden = menu.classList.contains("hidden")
          menu.classList.toggle("hidden", !isHidden)
          const svg = btn.querySelector("svg")
          if (svg)
            svg.innerHTML = isHidden
              ? '<path d="M18 6 6 18M6 6l12 12" />'
              : '<path d="M4 8h16M4 16h16" />'
        })

        menu.querySelectorAll("a").forEach((link) => {
          link.addEventListener("click", () => {
            menu.classList.add("hidden")
            const svg = btn.querySelector("svg")
            if (svg) svg.innerHTML = '<path d="M4 8h16M4 16h16" />'
          })
        })
      })()
    </script>
  </body>
</html>
