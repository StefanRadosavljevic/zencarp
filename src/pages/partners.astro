---
// partners.astro — ZenCarp partner offer page
// Broadcast-first redesign: F1 timing-tower graphics meet a lake in Banat.
import Layout from "@/layouts/main.astro"

const BASE = import.meta.env.BASE_URL
const fontHeading = "font-[family-name:var(--font-poppins)]"
const fontBody = "font-[family-name:var(--font-inter)]"
const fontData = "font-[family-name:var(--font-oswald)]"

const tickerItems = [
  "PILOT PROJEKAT",
  "JEDAN POSEBAN VIDEO",
  "KOMPLETAN IZBOR NAJBOLJIH SNIMAKA",
  "20.000 RSD",
  "VOJVODA STEPA, BANAT",
]

const heroStats = [
  { label: "CENA PAKETA", value: "20.000 RSD" },
  { label: "POSEBAN VIDEO", value: "15–20s" },
  { label: "NAJBOLJI SNIMCI", value: "SA VAŠIM LOGOM" },
  { label: "PRVO IZDANJE", value: "2026" },
]

const mainBenefits = [
  {
    title: "Vaš poseban video",
    desc: "Jedan video od 15–20 sekundi napravljen isključivo za vas, sa jedinstvenim kadrovima sa turnira i vašim logotipom.",
  },
  {
    title: "Kompletan izbor najboljih snimaka",
    desc: "Najbolji ulovi, borbe sa ribom, atmosfera i snimci dronom. Svaki partner dobija ceo ovaj izbor.",
  },
  {
    title: "Logo tokom prenosa",
    desc: "Vaš logotip biće prikazan u traci partnera tokom YouTube prenosa i na stranici sa rezultatima uživo.",
  },
]

const deliveryTable = [
  { item: "Poseban video (15–20 sekundi)", unique: "DA", shared: "NE" },
  { item: "Izbor najboljih snimaka sa turnira", unique: "NE", shared: "DA" },
  { item: "Logo u video materijalu", unique: "VAŠ LOGO", shared: "VAŠ LOGO" },
  { item: "Logo u YouTube prenosu", unique: "DA", shared: "DA" },
  { item: "Logo na rezultatima uživo", unique: "DA", shared: "DA" },
]

const usageChannels = [
  "Instagram (Reels / Feed)",
  "Facebook stranica",
  "TikTok",
  "YouTube kanal",
  "Sajt kompanije",
  "Ostali sopstveni digitalni kanali",
]

const faqItems = [
  {
    q: "Šta tačno dobijam za 20.000 RSD?",
    a: "Dobijate jedan poseban video od 15–20 sekundi napravljen za vašu kompaniju, kompletan izbor najboljih obrađenih snimaka sa turnira (svaki sa vašim logotipom), kao i prikaz logotipa tokom prenosa i na rezultatima uživo.",
  },
  {
    q: "Da li dobijam jedan video ili više videa?",
    a: "Dobijate dva skupa materijala: 1) Jedan poseban video od 15–20 sekundi koji je unikatan za vas, i 2) Kompletan izbor najboljih kratkih snimaka sa turnira (npr. 20 različitih snimaka).",
  },
  {
    q: "Koliko traje poseban video?",
    a: "Između 15 i 20 sekundi, optimizovan za objavljivanje na društvenim mrežama.",
  },
  {
    q: "Da li moj poseban video ima iste kadrove kao video druge kompanije?",
    a: "Ne. Tokom turnira snimamo veliki broj različitih kadrova. Za vaš video biramo konkretne kadrove koji se ne koriste u posebnom videu druge kompanije. Svaka firma dobija svoj jedinstveni izbor.",
  },
  {
    q: "Da li dobijam sve najbolje snimke sa turnira?",
    a: "Da. Nakon turnira biramo najbolje snimke i svaki partner dobija kompletan taj izbor.",
  },
  {
    q: "Da li svaki od tih snimaka ima moj logotip?",
    a: "Da. Za svakog partnera se pravi poseban izvoz video materijala u kojem se nalazi isključivo logo tog partnera. Niko ne dobija fajl sa logotipovima drugih firmi.",
  },
  {
    q: "Da li dobijam sirove snimke?",
    a: "Ne. Dobijate gotove, obrađene i završene video snimke spremne za objavu, a ne sirove fajlove sa kamera ili drona.",
  },
  {
    q: "Da li mogu da objavim dobijene snimke?",
    a: "Da. Video materijale dobijate spremne za objavljivanje i možete ih slobodno koristiti u komunikaciji svoje kompanije na vašim kanalima.",
  },
  {
    q: "Da li svi partneri dobijaju isti paket?",
    a: "Da. Cena je 20.000 RSD i svi partneri dobijaju identičan paket usluga. Nema različitih nivoa sponzorstva ni skrivenih doplata.",
  },
  {
    q: "Da li se nešto dodatno plaća?",
    a: "Ne. Sve navedeno je uključeno u jedinstvenu cenu od 20.000 RSD.",
  },
  {
    q: "Šta ako se turnir ne održi?",
    a: "U tom slučaju, dogovaramo novi termin ili vam u potpunosti vraćamo uplaćena sredstva.",
  },
]

const eventInfo = [
  { label: "Lokacija", value: "Vojvoda Stepa, Banat" },
  { label: "Format", value: "4 ekipe · po 2 takmičara" },
  { label: "Trajanje", value: "5 sati na vodi" },
  { label: "Jezero", value: "100 × 100 metara" },
  { label: "Produkcija", value: "Više kamera + dron" },
  { label: "Prenos", value: "Komentator + rezultati uživo" },
]
---

<Layout
  title="ZEN CARP — Video sadržaj za vašu kompaniju"
  description="ZenCarp je pilot projekat ribolovnog takmičenja koji kompanijama nudi konkretan video sadržaj sa turnira, spreman za društvene mreže."
>
  <div class={`min-h-screen bg-[#060a06] ${fontBody} text-[#e8e8e8]`}>
    <!-- Ticker -->
    <div class="overflow-hidden border-b border-[#111a11] bg-[#080c08] py-2">
      <div
        class={`ticker flex w-max gap-10 whitespace-nowrap text-[11px] font-medium uppercase tracking-[0.2em] text-[#c9a227] ${fontData}`}
      >
        {
          [...Array(2)].map(() =>
            tickerItems.map((item) => (
              <span class="flex items-center gap-10">
                {item}
                <span class="text-[#333]">/</span>
              </span>
            ))
          )
        }
      </div>
    </div>

    <!-- HERO -->
    <section
      class="relative flex min-h-[92vh] flex-col justify-end overflow-hidden"
    >
      <video
        autoplay
        loop
        muted
        playsinline
        class="absolute inset-0 h-full w-full object-cover"
      >
        <source src={`${BASE}fishing.mp4`} type="video/mp4" />
      </video>
      <div
        class="absolute inset-0 bg-gradient-to-t from-[#060a06] via-[#060a06]/75 to-[#060a06]/40"
      >
      </div>

      <div class="relative z-10 mx-auto w-full max-w-6xl px-5 pt-32 pb-14">
        <div class="mb-6 flex items-center gap-3">
          <span class="live-dot"></span>
          <span
            class={`text-xs font-semibold uppercase tracking-[0.3em] text-[#e8e8e8] ${fontData}`}
          >
            Pilot projekat
          </span>
        </div>

        <h1
          class={`text-[10vw] sm:text-[5rem] font-bold leading-[1.1] text-[#f0f0f0] ${fontHeading}`}
        >
          Video sadržaj sa ZenCarp turnira — <br class="hidden sm:block" />
          <span class="text-[#c9a227]">napravljen za vašu kompaniju.</span>
        </h1>

        <div class="mt-6 flex items-baseline gap-3">
          <span
            class={`text-4xl sm:text-5xl font-bold text-[#c9a227] ${fontData}`}
            >20.000 RSD</span
          >
        </div>

        <p
          class="mt-6 max-w-2xl text-[16px] leading-relaxed text-[#ccc] sm:text-lg"
        >
          Za 20.000 RSD dobijate jedan poseban video od 15–20 sekundi za svoju
          kompaniju, kao i kompletan izbor najboljih obrađenih snimaka sa
          turnira — svaki sa vašim logotipom.
        </p>

        <div class="mt-9 flex flex-wrap items-center gap-4">
          <a
            href="#benefits"
            class={`rounded-full bg-[#c9a227] px-8 py-3.5 text-sm font-medium text-[#0a0f0a] transition-colors hover:bg-[#d4b43a] ${fontHeading}`}
          >
            Šta tačno dobijate
          </a>
          <a
            href="#enter"
            class={`rounded-full border border-[#2a3a2a] px-8 py-3.5 text-sm font-medium text-[#e0e0e0] transition-colors hover:border-[#c9a227]/50 hover:text-[#c9a227] ${fontHeading}`}
          >
            Postani partner
          </a>
        </div>

        <div
          class={`mt-14 grid grid-cols-2 gap-x-8 gap-y-6 border-t border-[#1a2e1a] pt-6 sm:flex sm:flex-wrap sm:gap-x-12 ${fontData}`}
        >
          {
            heroStats.map((s) => (
              <div>
                <div class="text-[10px] tracking-[0.25em] text-[#777] uppercase">
                  {s.label}
                </div>
                <div class="mt-1 text-2xl font-medium text-[#f0f0f0]">
                  {s.value}
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- MAIN BENEFITS -->
    <section
      id="benefits"
      class="reveal border-y border-[#111a11] bg-[#080c08] px-5 py-24"
    >
      <div class="mx-auto max-w-6xl">
        <div class="mb-14 max-w-2xl">
          <div
            class={`mb-4 text-xs font-semibold uppercase tracking-[0.25em] text-[#c9a227] ${fontData}`}
          >
            Ponuda
          </div>
          <h2
            class={`mb-5 text-3xl font-bold leading-tight text-[#f0f0f0] sm:text-4xl ${fontHeading}`}
          >
            Šta tačno dobijate.
          </h2>
          <p class="text-[15px] leading-relaxed text-[#999]">
            Jednostavna i transparentna ponuda. Svi partneri plaćaju istu cenu i
            dobijaju isti paket, bez skrivenih troškova ili različitih nivoa
            sponzorstva.
          </p>
        </div>

        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {
            mainBenefits.map((b, i) => (
              <div class="rounded-xl border border-[#1a2e1a] bg-[#0a0f0a] p-6">
                <div
                  class={`mb-3 text-sm font-medium tracking-[0.1em] text-[#c9a227] uppercase ${fontData}`}
                >
                  0{i + 1} / {b.title}
                </div>
                <div class="text-[15px] leading-relaxed text-[#aaa]">
                  {b.desc}
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- SPECIAL VIDEO DETAIL -->
    <section class="reveal px-5 py-24">
      <div class="mx-auto grid max-w-6xl items-center gap-14 lg:grid-cols-2">
        <div class="order-2 lg:order-1">
          <div
            class={`mb-4 text-xs font-semibold uppercase tracking-[0.25em] text-[#c9a227] ${fontData}`}
          >
            Vaš poseban video
          </div>
          <h2
            class={`mb-6 text-3xl font-bold leading-tight text-[#f0f0f0] sm:text-4xl ${fontHeading}`}
          >
            Jedinstveni kadrovi za vašu kompaniju.
          </h2>
          <div class="space-y-4 text-[15px] leading-relaxed text-[#aaa]">
            <p>
              Svaka kompanija dobija <strong class="text-[#e8e8e8]"
                >jedan poseban video</strong
              > koji se pravi isključivo za nju.
            </p>
            <p>
              Tokom turnira snimamo veliki broj različitih kadrova kamerama i
              dronom. Za vaš video biramo konkretne kadrove koji se <strong
                class="text-[#e8e8e8]">ne koriste</strong
              > u posebnom videu druge kompanije.
            </p>
            <p class="text-[#c9a227]">
              Primer: Ako tokom turnira snimimo 30 različitih kadrova dronom,
              nećemo isti kadar koristiti u posebnom videu dve kompanije. Svaka
              kompanija dobija svoj izbor kadrova.
            </p>
            <ul class="mt-4 space-y-2 text-sm text-[#999]">
              <li class="flex items-center gap-2">
                <span class="h-1 w-1 rounded-full bg-[#c9a227]"></span>Trajanje:
                15–20 sekundi
              </li>
              <li class="flex items-center gap-2">
                <span class="h-1 w-1 rounded-full bg-[#c9a227]"></span>Sadrži
                logotip vaše kompanije
              </li>
              <li class="flex items-center gap-2">
                <span class="h-1 w-1 rounded-full bg-[#c9a227]"></span>Spreman
                za objavljivanje na društvenim mrežama
              </li>
            </ul>
          </div>
        </div>

        <div class="order-1 flex justify-center lg:order-2">
          <div
            class="relative w-[320px] overflow-hidden rounded-[2.5rem] border-4 border-[#111a11] bg-[#0a0f0a] shadow-2xl shadow-black/50 sm:w-[360px] lg:w-[400px]"
          >
            <div
              class="absolute top-0 left-1/2 z-10 h-6 w-32 -translate-x-1/2 rounded-b-2xl bg-[#111a11]"
            >
            </div>
            <video
              src={`${BASE}ZenCarpPhone.mp4`}
              loop
              muted
              playsinline
              autoplay
              class="aspect-[9/16] h-auto w-full object-cover"></video>
          </div>
        </div>
      </div>
    </section>

    <!-- BEST CLIPS DETAIL -->
    <section class="reveal border-y border-[#111a11] bg-[#080c08] px-5 py-24">
      <div class="mx-auto max-w-4xl text-center">
        <div
          class={`mb-4 text-xs font-semibold uppercase tracking-[0.25em] text-[#c9a227] ${fontData}`}
        >
          Kompletan izbor
        </div>
        <h2
          class={`mb-6 text-3xl font-bold leading-tight text-[#f0f0f0] sm:text-4xl ${fontHeading}`}
        >
          Svi najbolji snimci sa turnira.
        </h2>
        <p
          class="mx-auto mb-10 max-w-xl text-[15px] leading-relaxed text-[#aaa]"
        >
          Tokom turnira snimamo ulove, borbu sa ribom, merenje, vraćanje ribe u
          vodu, reakcije takmičara, atmosferu i snimke dronom. Nakon turnira od
          tog materijala pravimo <strong class="text-[#e8e8e8]"
            >izbor najboljih video snimaka</strong
          >.
        </p>

        <div
          class="rounded-xl border border-[#1a2e1a] bg-[#0a0f0a] p-8 text-left"
        >
          <p class="text-[15px] leading-relaxed text-[#ccc]">
            <strong class="text-[#c9a227]">Primer isporuke:</strong> Ako nakon turnira
            odaberemo 20 najboljih kratkih video snimaka, kompanija A dobija svih
            20 snimaka sa logotipom A. Kompanija B takođe dobija svih 20 snimaka,
            ali sa logotipom B.
            <span class="mt-3 block text-[#888]"
              >Niko ne dobija zajednički fajl sa logotipovima drugih partnera.
              Dobijate isključivo verziju sa vašim logotipom.</span
            >
          </p>
        </div>
      </div>
    </section>

    <!-- DELIVERY TABLE -->
    <section class="reveal px-5 py-24">
      <div class="mx-auto max-w-4xl">
        <div
          class={`mb-8 text-center text-xs font-semibold uppercase tracking-[0.25em] text-[#c9a227] ${fontData}`}
        >
          Pregled isporuke
        </div>
        <div
          class="overflow-hidden rounded-xl border border-[#1a2e1a] bg-[#0a0f0a]"
        >
          <div
            class="grid grid-cols-3 border-b border-[#1a2e1a] bg-[#0f140f] text-sm font-medium tracking-[0.1em] text-[#c9a227] uppercase"
          >
            <div class="p-4 text-left">Šta dobijate</div>
            <div class="border-l border-[#1a2e1a] p-4 text-center">
              Posebno za vas
            </div>
            <div class="border-l border-[#1a2e1a] p-4 text-center">
              Dobijaju svi partneri
            </div>
          </div>
          {
            deliveryTable.map((row, i) => (
              <div
                class={`grid grid-cols-3 text-[15px] ${i !== deliveryTable.length - 1 ? "border-b border-[#1a2e1a]" : ""}`}
              >
                <div class="p-4 text-[#e8e8e8]">{row.item}</div>
                <div class="border-l border-[#1a2e1a] p-4 text-center font-medium text-[#c9a227]">
                  {row.unique}
                </div>
                <div class="border-l border-[#1a2e1a] p-4 text-center font-medium text-[#c9a227]">
                  {row.shared}
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- USAGE -->
    <section class="reveal border-y border-[#111a11] bg-[#080c08] px-5 py-24">
      <div class="mx-auto max-w-4xl">
        <div
          class={`mb-4 text-xs font-semibold uppercase tracking-[0.25em] text-[#c9a227] ${fontData}`}
        >
          Primena
        </div>
        <h2
          class={`mb-6 max-w-2xl text-3xl font-bold leading-tight text-[#f0f0f0] sm:text-4xl ${fontHeading}`}
        >
          Gde možete da koristite materijal?
        </h2>
        <p class="mb-8 max-w-xl text-[15px] leading-relaxed text-[#aaa]">
          Video materijale dobijate spremne za objavljivanje i možete ih
          koristiti u komunikaciji svoje kompanije na sledećim kanalima:
        </p>
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {
            usageChannels.map((channel) => (
              <div class="flex items-center gap-3 rounded-lg border border-[#1a2e1a] bg-[#0a0f0a] p-4 text-sm text-[#ccc]">
                <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-[#c9a227]" />
                {channel}
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ADDITIONAL & HOW IT'S MADE -->
    <section
      id="live"
      class="reveal border-y border-[#111a11] bg-[#080c08] px-5 py-24"
    >
      <div class="mx-auto max-w-6xl">
        <div class="mb-14 max-w-2xl">
          <div
            class={`mb-4 text-xs font-semibold uppercase tracking-[0.25em] text-[#c9a227] ${fontData}`}
          >
            Dodatno tokom turnira
          </div>
          <h2
            class={`mb-5 text-3xl font-bold leading-tight text-[#f0f0f0] sm:text-4xl ${fontHeading}`}
          >
            Vaš logotip u prenosu.
          </h2>
          <p class="text-[15px] leading-relaxed text-[#999]">
            Iako je glavni proizvod video sadržaj koji dobijate nakon turnira,
            vaš logotip će biti vidljiv i tokom samog događaja u traci partnera
            tokom YouTube prenosa i na stranici sa rezultatima uživo.
          </p>
        </div>

        <div class="grid gap-10 lg:grid-cols-[1.1fr_1fr]">
          <div
            class="relative aspect-[16/9] overflow-hidden rounded-xl border border-[#1a2e1a] bg-[#060a06]"
          >
            <video
              autoplay
              loop
              muted
              playsinline
              class="h-full w-full object-contain"
            >
              <source src={`${BASE}ZenCarpOverlay.mp4`} type="video/mp4" />
            </video>
          </div>

          <div class="rounded-xl border border-[#1a2e1a] bg-[#0a0f0a] p-6">
            <h3 class={`mb-4 text-lg font-bold text-[#f0f0f0] ${fontHeading}`}>
              Kako nastaje materijal?
            </h3>
            <ul class="space-y-3 text-[14px] leading-relaxed text-[#aaa]">
              <li class="flex items-start gap-3">
                <span
                  class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-[#c9a227]"
                ></span>
                <span
                  >Četiri ekipe (osam takmičara) takmiče se pet sati na jezeru
                  dimenzija 100×100 metara.</span
                >
              </li>
              <li class="flex items-start gap-3">
                <span
                  class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-[#c9a227]"
                ></span>
                <span
                  >Celokupan događaj pratimo sa više stalnih kamera, jednom
                  terenskom kamerom u pokretu i dronom.</span
                >
              </li>
              <li class="flex items-start gap-3">
                <span
                  class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-[#c9a227]"
                ></span>
                <span
                  >Komentator i izveštač na terenu prate dešavanja i
                  objašnjavaju tok takmičenja.</span
                >
              </li>
              <li class="flex items-start gap-3">
                <span
                  class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-[#c9a227]"
                ></span>
                <span
                  >Tabela sa rezultatima uživo prikazuje svaku promenu plasmana
                  čim se riba izmeri.</span
                >
              </li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- LOGISTICS & IMPORTANT NOTE -->
    <section
      id="info"
      class="reveal border-y border-[#111a11] bg-[#080c08] px-5 py-24"
    >
      <div class="mx-auto max-w-3xl">
        <div
          class={`mb-4 text-xs font-semibold uppercase tracking-[0.25em] text-[#c9a227] ${fontData}`}
        >
          Logistika
        </div>
        <h2
          class={`mb-10 text-3xl font-bold leading-tight text-[#f0f0f0] sm:text-4xl ${fontHeading}`}
        >
          Šta treba da nam pošaljete.
        </h2>

        <div class="mb-12 rounded-xl border border-[#1a2e1a] bg-[#0a0f0a] p-6">
          <p class="text-[15px] leading-relaxed text-[#aaa]">
            Potreban nam je isključivo <strong class="text-[#e8e8e8]"
              >kvalitetan logotip vaše kompanije</strong
            > (vektorski .svg, .eps ili .png visoke rezolucije), ukoliko ga već nemamo
            dostupnog. Ništa više. Mi preuzimamo kompletnu produkciju i obradu.
          </p>
        </div>

        <div class="rounded-xl border border-[#2a1a1a] bg-[#1a0f0f] p-6">
          <h3 class={`mb-3 text-lg font-bold text-[#e8e8e8] ${fontHeading}`}>
            Važna napomena
          </h3>
          <p class="mb-3 text-[14px] leading-relaxed text-[#aaa]">
            Da bismo sprečili pogrešna očekivanja, važno je napomenuti šta ovaj
            paket <strong class="text-[#e8e8e8]">NE</strong> podrazumeva:
          </p>
