---
// src/pages/pravilnik.astro
import Layout from "@/layouts/main.astro"

// ══ Isti fontovi kao na landing page ══
const fontHeading = "font-[family-name:var(--font-poppins)]"
const fontBody = "font-[family-name:var(--font-inter)]"
const BASE = import.meta.env.BASE_URL

type Rule = { title: string; text: string; note?: string }
type Section = { id: string; title: string; rules: Rule[] }

const sections: Section[] = [
  {
    id: "format",
    title: "Format turnira",
    rules: [
      {
        title: "Učesnici",
        text: "Turnir se igra u timovima od dva punoletna takmičara. Jedan takmičar ne može nastupiti samostalno.",
      },
      {
        title: "Trajanje",
        text: "Pecanje traje 4 sata bez prekida, od zvaničnog početka do zvaničnog kraja turnira. Hranjenje pozicije dozvoljeno je pre početka i tokom celog turnira, bez ograničenja količine i broja prihranjivanja, osim ako pravila jezera domaćina određuju drugačije.",
      },
      {
        title: "Dodela pozicija",
        text: "Pre početka turnira organizator priprema četiri papirića sa oznakama P1, P2, P3 i P4. Svaki tim izvlači jedan papirić i time dobija svoju poziciju za ceo turnir. Nakon izvlačenja pozicija se ne može menjati.",
      },
      {
        title: "Plasman",
        text: "Plasman se određuje po ukupnoj težini svih priznatih ulova. Boduju se isključivo šaran i amur. Riba mora imati najmanje 500 g da bi se računala u rezultat.",
      },
      {
        title: "Izjednačenje",
        text: "Ako dva ili više timova imaju potpuno istu ukupnu težinu, dele isto mesto. Ako je potrebno odrediti kome pripada medalja ili druga fizička nagrada za to mesto, redosled se određuje nasumičnim izvlačenjem odmah nakon proglašenja.",
      },
      {
        title: "Tim bez ulova",
        text: "Tim koji nema nijedan priznat ulov nema dodatnu kaznu niti se diskvalifikuje. Svi timovi bez ulova dele poslednje mesto.",
      },
    ],
  },
  {
    id: "prijava",
    title: "Prijava i kotizacija",
    rules: [
      {
        title: "Ko prijavljuje",
        text: "Prijaviti se može svaki tim koji čine dva punoletna takmičara. Prijava jednog takmičara bez partnera nije moguća.",
      },
      {
        title: "Rok za prijavu",
        text: "Rok za prijavu objavljuje se zajedno sa datumom održavanja turnira.",
      },
      {
        title: "Kotizacija i plaćanje",
        text: "Kotizacija iznosi 50€ po timu. Plaća se u gotovini na dan turnira, prilikom prijave ekipe.",
      },
      {
        title: "Kontakt za prijavu",
        text: "Za prijavu i sva pitanja koristi se kontakt organizatora. Isti kontakt važi za prijavu, pitanja i dogovor oko učešća.",
        note: "[ KONTAKT TELEFON / WHATSAPP ]\n[ EMAIL ]",
      },
      {
        title: "Obavezni dokumenti",
        text: "Pre početka turnira oba člana tima moraju potpisati izjavu o odricanju odgovornosti i saglasnost za fotografisanje i snimanje. Takmičar koji ne potpiše potrebne dokumente ne može učestvovati na turniru.",
      },
    ],
  },
  {
    id: "oprema",
    title: "Oprema i logistika",
    rules: [
      {
        title: "Štapovi",
        text: "Svaki tim može koristiti najviše 8 štapova, raspoređenih na najviše 2 rodpoda. U vodi istovremeno može biti najviše 8 štapova po timu.",
      },
      {
        title: "Mamci i hrana",
        text: "Dozvoljeni su svi mamci i načini prihranjivanja koji su dozvoljeni pravilima jezera domaćina. Živa riba ne sme da se koristi kao mamac.",
      },
      {
        title: "Infrastruktura na poziciji",
        text: "Na svakoj poziciji nalazi se samo obeleženo mesto za takmičarski tim. Na pozicijama nema obezbeđene struje, vode, šatora, stolica, osvetljenja niti toaleta. Svaki tim sam obezbeđuje opremu koja mu je potrebna.",
      },
      {
        title: "Alkohol, muzika i kretanje",
        text: "Alkohol je dozvoljen, ali svaki tim odgovara za svoje ponašanje. Muzika nije dozvoljena tokom celog turnira. Nije dozvoljeno nepotrebno kretanje oko jezera niti ulaženje u prostor druge ekipe.",
      },
      {
        title: "Hrana i piće od organizatora",
        text: "Svaki tim dobija jednu porciju hrane i jedno piće od organizatora. Sve dodatne potrebe za hranom i pićem tim obezbeđuje sam.",
      },
      {
        title: "Čišćenje",
        text: "Nakon završetka turnira svaki tim mora da ostavi svoju poziciju čistom. Svo smeće koje je tim napravio mora biti sakupljeno i odneto.",
      },
    ],
  },
  {
    id: "merenje",
    title: "Procedura merenja",
    rules: [
      {
        title: "Ko meri",
        text: "Ribu meri isključivo redar organizatora. Takmičari ne određuju sami težinu ulova niti samostalno upisuju rezultat.",
      },
      {
        title: "Pozivanje redara",
        text: "Nakon što je riba izvučena iz vode, tim mora odmah pozvati redara. Redar mora biti pozvan najkasnije 60 sekundi nakon izvlačenja ribe. Ako tim ne pozove redara u tom roku, riba se ne računa u rezultat.",
      },
      {
        title: "Minimalna težina",
        text: "Minimalna težina priznate ribe je 500 g. Riba od 500 g ili više računa se u rezultat, dok se riba od 499 g ili manje ne računa. Nema zaokruživanja težine.",
      },
      {
        title: "Spuštena riba",
        text: "Ako riba spadne sa udice pre nego što je izmerena, ulov se ne računa. Kada je riba izmerena i rezultat upisan, njen naknadni gubitak ne utiče na već priznati rezultat.",
      },
      {
        title: "Catch & Release",
        text: "Svaka priznata riba mora biti vraćena u jezero nakon merenja. Riba se ne zadržava nakon merenja niti se nosi sa pozicije.",
      },
      {
        title: "Sporne situacije",
        text: "Ako dođe do spora oko ulova, merenja ili primene pravila, konačnu odluku donosi glavni sudija na licu mesta. Odluka glavnog sudije važi za taj slučaj.",
      },
    ],
  },
  {
    id: "ponasanje",
    title: "Ponašanje i red",
    rules: [
      {
        title: "Publika i gledaoci",
        text: "Ulaz za publiku je besplatan, deca su dobrodošla, a parking je obezbeđen. Gledaoci mogu boraviti samo u prostorima predviđenim za publiku i ne smeju ulaziti u takmičarske pozicije bez dozvole organizatora.",
      },
      {
        title: "Obaveze tima pre starta",
        text: "Pre početka turnira oba člana ekipe moraju potvrditi prijavu, platiti kotizaciju, potpisati potrebne izjave, prisustvovati izvlačenju pozicija i zauzeti dodeljenu poziciju.",
      },
      {
        title: "Disciplina",
        text: "Zabranjeno je vređanje, pretnje, namerno ometanje drugog tima, ulaženje u tuđu poziciju bez dozvole, pomeranje tuđe opreme i ponašanje kojim se ugrožava bezbednost drugih ljudi. Za lakši prekršaj sudija može dati opomenu, a za ozbiljan ili ponovljen prekršaj može diskvalifikovati tim.",
      },
    ],
  },
  {
    id: "nagrada",
    title: "Nagrada i isplata",
    rules: [
      {
        title: "Nagradni fond",
        text: "Nagradni fond iznosi 200€ i pobednik dobija ceo fond. Kod četiri prijavljena tima fond čine četiri kotizacije po 50€. Sponzorski novac nije deo nagradnog fonda.",
      },
      {
        title: "Isplata",
        text: "Nagrada se isplaćuje u gotovini na licu mesta, odmah nakon završetka merenja, provere rezultata i proglašenja pobednika. Nema odložene isplate niti prenosa nagrade na račun.",
      },
    ],
  },
  {
    id: "otkazivanje",
    title: "Otkazivanje i zamena",
    rules: [
      {
        title: "Otkazivanje učešća",
        text: "Nakon prijave, kotizacija se ne vraća u slučaju da tim odustane od učešća.",
      },
      {
        title: "Zamena takmičara",
        text: "Takmičar može biti zamenjen pre početka turnira. Tim sam pronalazi zamenu i mora o tome obavestiti organizatora najkasnije pre početka izvlačenja pozicija. Nakon završenog izvlačenja zamena više nije dozvoljena.",
      },
    ],
  },
  {
    id: "nevreme",
    title: "Nevreme i odloženi termin",
    rules: [
      {
        title: "Kiša",
        text: "Obična kiša ne prekida turnir. Turnir se održava po kiši i planirano trajanje se ne menja.",
      },
      {
        title: "Grad i jako nevreme",
        text: "Ako vremenski uslovi ugrožavaju bezbednost takmičara, publike ili organizatora, glavni sudija može prekinuti ili odložiti turnir. U tom slučaju turnir se pomera na najbliži mogući slobodan termin, a već plaćene kotizacije ostaju važeće za novi termin.",
      },
    ],
  },
]
---

<Layout
  title="Pravilnik – ZenCarp"
  description="Pravilnik i propozicije takmičenja ZenCarp"
>
  <div
    class={`min-h-screen bg-[#060a06] ${fontBody} text-[#e8e8e8] selection:bg-[#c9a227] selection:text-black`}
  >
    <!-- Glavni sadržaj -->
    <main class="mx-auto max-w-3xl px-5 pt-10 pb-20">
      <h1
        class={`mb-8 text-4xl font-extrabold tracking-tight text-[#f0f0f0] ${fontHeading}`}
      >
        Pravilnik i propozicije
      </h1>

      {
        sections.map((section) => (
          <section id={section.id} class="mb-12 scroll-mt-24">
            <h2 class={`mb-4 text-2xl font-bold text-[#c9a227] ${fontHeading}`}>
              {section.title}
            </h2>
            <div class="space-y-4">
              {section.rules.map((rule, idx) => (
                <div class="border-b border-[#1a2e1a]/40 pb-3 last:border-0">
                  <h3
                    class={`text-lg font-semibold text-[#e0e0e0] ${fontHeading}`}
                  >
                    {rule.title}
                  </h3>
                  <p class="mt-1 text-[15px] leading-relaxed text-[#aaa]">
                    {rule.text}
                  </p>
                  {rule.note && (
                    <p
                      class={`mt-2 text-sm whitespace-pre-line text-[#c9a227]/80 ${fontBody}`}
                    >
                      {rule.note}
                    </p>
                  )}
                </div>
              ))}
            </div>
          </section>
        ))
      }

      <!-- Završna napomena -->
      <div
        class="mt-12 rounded-xl border border-[#1a2e1a] bg-[#0d140d]/60 p-6 text-center"
      >
        <p class="text-sm leading-relaxed text-[#777]">
          Odluka glavnog sudije na licu mesta je uvek konačna. Organizator
          zadržava pravo dopune pravila do dana turnira.
          <br />
          Za sva pitanja i prijave —{" "}
          <a
            href="mailto:zencarp@outlook.com"
            class="text-[#c9a227] underline underline-offset-4 hover:text-[#f0f0f0]"
          >
            zencarp@outlook.com
          </a>
        </p>
      </div>
    </main>
  </div>
</Layout>
