---
// src/pages/lake.astro
import Layout from "@/layouts/main.astro"

const BASE = import.meta.env.BASE_URL
const fontHeading = "font-[family-name:var(--font-poppins)]"
const fontBody = "font-[family-name:var(--font-inter)]"
const fontData = "font-[family-name:var(--font-oswald)]"

const lakeStats = [
  { label: "POVRŠINA", value: "~1 HA" },
  { label: "DIMENZIJE", value: "100 × 100 M" },
  { label: "PROSEČNA DUBINA", value: "1.5 – 2 M" },
  { label: "MAKSIMALNA DUBINA", value: "4.5 M" },
]

const terrainFeatures = [
  {
    title: "Dno i reljef",
    desc: "Kombinacija muljevitih i tvrdih zona. Bez unapred poznatih mapa, platoa ili kanala – takmičari sami čitaju vodu.",
  },
  {
    title: "Centralno ostrvo",
    desc: "Poluprečnik oko 5 metara, dostupno za pecanje. Direktno utiče na raspored hranjenja i taktički izbor pozicije.",
  },
  {
    title: "Vegetacija",
    desc: "Trska uz obalu i podvodna trava. Bez lokvanja, panjeva ili granja, što omogućava čistu i kontrolisanu borbu.",
  },
  {
    title: "Riblji fond",
    desc: "1–2 tone ukupno. Šaran (2–6 kg, prosek 4 kg) i amur (6–15 kg, prosek 6–7 kg).",
  },
]
---

<Layout
  title="Teren — ZenCarp"
  description="Upoznajte teren takmičenja ZenCarp u Vojvodi Stepi, Banat. Jezero koje se svojim karakteristikama pokazalo kao odlična osnova za takmičarski ribolov."
>
  <div class={`min-h-screen bg-[#060a06] ${fontBody} text-[#e8e8e8]`}>
    <!-- PAGE HERO (Identičan skaliran dizajn kao index.astro) -->
    <section
      class="relative flex min-h-[85vh] flex-col justify-end overflow-hidden"
    >
      <div
        class="absolute inset-0 bg-gradient-to-t from-[#060a06] via-[#060a06]/80 to-[#060a06]/40"
      >
      </div>

      <div class="relative z-10 mx-auto w-full max-w-6xl px-5 pt-32 pb-14">
        <div class="mb-6 flex items-center gap-3">
          <span class="h-2 w-2 rounded-full bg-[#c9a227]"></span>
          <span
            class={`text-xs font-semibold uppercase tracking-[0.3em] text-[#e8e8e8] ${fontData}`}
          >
            Lokacija takmičenja
          </span>
        </div>

        <h1
          class={`text-[14vw] font-bold leading-[0.85] text-[#f0f0f0] sm:text-[8rem] ${fontHeading}`}
        >
          JEZERO<span class="text-[#c9a227]">ZENCARP</span>
        </h1>

        <p
          class="mt-8 max-w-xl text-[15px] leading-relaxed text-[#ccc] sm:text-lg"
        >
          Vojvoda Stepa, Banat, Srbija. Jezero koje se svojim prirodnim
          karakteristikama pokazalo kao odlična osnova za takmičarski ribolov
          šarana.
        </p>

        <div
          class={`mt-14 grid grid-cols-2 gap-x-8 gap-y-6 border-t border-[#1a2e1a] pt-6 sm:flex sm:flex-wrap sm:gap-x-12 ${fontData}`}
        >
          {
            lakeStats.map((s) => (
              <div>
                <div class="text-[10px] tracking-[0.25em] text-[#777] uppercase">
                  {s.label}
                </div>
                <div class="mt-1 text-2xl font-medium text-[#f0f0f0]">
                  {s.value}
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- MAIN DESCRIPTION (Split layout kao "Koncept" sekcija u index.astro) -->
    <section class="reveal px-5 py-24">
      <div class="mx-auto grid max-w-6xl gap-14 lg:grid-cols-[1fr_1fr]">
        <div>
          <div
            class={`mb-4 text-xs font-semibold uppercase tracking-[0.25em] text-[#c9a227] ${fontData}`}
          >
            Karakteristike terena
          </div>
          <h2
            class={`mb-6 text-3xl font-bold leading-tight text-[#f0f0f0] sm:text-4xl ${fontHeading}`}
          >
            Prirodno okruženje sa specifičnim izazovima.
          </h2>
          <div class="space-y-4 text-[15px] leading-relaxed text-[#aaa]">
            <p>
              Jezero je veliko oko jedan hektar, dimenzija otprilike 100 × 100
              metara, i nosi svoj poseban izazov. Obala je uređena i pogodna za
              postavljanje opreme, a okolno drveće daje mir i tišinu koja pomaže
              koncentraciji tokom takmičenja.
            </p>
            <p>
              Dubina jezera traži poseban pristup. Prosečna dubina kreće se
              između 1,5 i 2 metra, sa maksimumom od 4,5 metara. Dno je
              kombinacija muljevitih i tvrdih zona. Kako ne postoji precizna
              mapa podvodnog reljefa, takmičari ne mogu da se oslone na unapred
              poznate strukture — strategiju grade sami, obeležavanjem i
              čitanjem vode.
            </p>
          </div>
        </div>

        <div
          class="flex items-center justify-center overflow-hidden rounded-xl border border-[#1a2e1a] bg-[#0a0f0a]"
        >
          <img
            src={`${BASE}final_lake.jpeg`}
            alt="Jezero ZenCarp"
            class="h-full w-full object-cover"
          />
        </div>
      </div>
    </section>

    <!-- FEATURES LIST (Stil kao "Uživo" sekcija u index.astro) -->
    <section class="reveal border-y border-[#111a11] bg-[#080c08] px-5 py-24">
      <div class="mx-auto max-w-6xl">
        <div class="mb-14 max-w-2xl">
          <div
            class={`mb-4 text-xs font-semibold uppercase tracking-[0.25em] text-[#c9a227] ${fontData}`}
          >
            Detalji terena
          </div>
          <h2
            class={`mb-5 text-3xl font-bold leading-tight text-[#f0f0f0] sm:text-4xl ${fontHeading}`}
          >
            Svaki detalj utiče na taktiku.
          </h2>
        </div>

        <div class="grid gap-10 lg:grid-cols-2">
          {
            terrainFeatures.map((f) => (
              <div class="flex items-start gap-4">
                <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-[#c9a227]" />
                <div>
                  <div
                    class={`text-sm font-medium tracking-[0.1em] text-[#e8e8e8] uppercase ${fontData}`}
                  >
                    {f.title}
                  </div>
                  <div class="mt-1 text-[15px] leading-relaxed text-[#888]">
                    {f.desc}
                  </div>
                </div>
              </div>
            ))
          }
        </div>

        <!-- HIGHLIGHT BOX -->
        <div
          class="mt-16 rounded-xl border border-[#c9a227]/20 bg-[#c9a227]/5 p-6 sm:p-8"
        >
          <h3 class={`mb-3 text-lg font-bold text-[#f0f0f0] ${fontHeading}`}>
            Prednost za gledaoce, izazov za takmičare
          </h3>
          <p class="text-[15px] leading-relaxed text-[#ccc]">
            Kompaktne dimenzije jezera olakšavaju praćenje za gledaoce na licu
            mesta. Ali manja površina ne znači i iste uslove za sve — svaka
            pozicija ima svoju dubinu i svoje dno, pa takmičari moraju da čitaju
            teren, a ne da se oslanjaju na sreću.
          </p>
        </div>
      </div>
    </section>

    <!-- FINAL CTA (Identičan dizajn kao na dnu index.astro) -->
    <section class="reveal relative overflow-hidden px-5 py-28">
      <div
        class="absolute inset-0 bg-gradient-to-b from-[#080c08] to-[#060a06]"
      >
      </div>
      <div class="relative mx-auto max-w-3xl text-center">
        <div
          class={`mb-4 text-xs font-semibold uppercase tracking-[0.25em] text-[#c9a227] ${fontData}`}
        >
          Sledeći korak
        </div>
        <h2
          class={`mb-4 text-3xl font-bold leading-tight text-[#f0f0f0] sm:text-5xl ${fontHeading}`}
        >
          Spremni za izazov?
        </h2>
        <p class="mb-10 text-[15px] leading-relaxed text-[#999] sm:text-lg">
          Pročitaj pravilnik, upoznaj se sa uslovima i prijavi svoju ekipu za
          naredni turnir na jezeru Vojvoda Stepa.
        </p>
        <div class="flex flex-wrap items-center justify-center gap-4">
          <a
            href="/pravilnik"
            class={`rounded-full border border-[#2a3a2a] px-8 py-3.5 text-sm font-medium text-[#e0e0e0] transition-colors hover:border-[#c9a227]/50 hover:text-[#c9a227] ${fontHeading}`}
          >
            Pravilnik takmičenja
          </a>
          <a
            href="#enter"
            class={`rounded-full bg-[#c9a227] px-8 py-3.5 text-sm font-medium text-[#0a0f0a] transition-colors hover:bg-[#d4b43a] ${fontHeading}`}
          >
            Prijavi ekipu
          </a>
        </div>
      </div>
    </section>
  </div>
</Layout>

<style is:global>
  .reveal {
    opacity: 0;
    transform: translateY(16px);
    transition:
      opacity 0.6s ease,
      transform 0.6s ease;
  }
  .reveal.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .reveal {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  const io = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) {
          entry.target.classList.add("is-visible")
          io.unobserve(entry.target)
        }
      }
    },
    { threshold: 0.15 }
  )
  document.querySelectorAll(".reveal").forEach((el) => io.observe(el))
</script>
