---
// index.astro – glavna stranica
import Layout from "@/layouts/main.astro"
import LiveBanner from "@/components/LiveBanner"

const BASE = import.meta.env.BASE_URL
const fontHeading = "font-[family-name:var(--font-poppins)]"
const fontBody = "font-[family-name:var(--font-inter)]"

// Navigacija
const navLinks = [
  { label: "Naslovna", href: BASE },
  { label: "Partneri", href: `${BASE}partners` },
  { label: "Rezultati", href: `${BASE}results` },
]

// CTA
const cta = { label: "Prijavi ekipu", href: "#prijava" }

// FAQ
const faq = [
  {
    q: "Koju opremu tim mora da obezbedi sam?",
    a: "Na pozicijama nema struje, vode, šatora, stolica ni toaleta. Molimo vas da ponesete svu neophodnu opremu za vaš tim.",
  },
  {
    q: "Da li organizator obezbeđuje hranu i piće?",
    a: "Svaki tim dobija jedan obrok i jedno piće. Sve dodatne potrebe snosi tim.",
  },
  {
    q: "Da li je alkohol dozvoljen tokom takmičenja?",
    a: "Alkohol je dozvoljen uz odgovorno ponašanje. Muzika nije dozvoljena tokom celog turnira.",
  },
  {
    q: "Šta se dešava sa ulovljenom ribom?",
    a: "Primenjujemo princip „catch & release“ – svaka izmerena riba se odmah vraća u vodu. Nijedna riba se ne zadržava.",
  },
  {
    q: "Koja dokumenta je potrebno potpisati?",
    a: "Pre početka, oba člana tima potpisuju izjavu o odricanju odgovornosti i saglasnost za fotografisanje i snimanje.",
  },
  {
    q: "Kako se postupa u slučaju kiše?",
    a: "Obična kiša ne prekida takmičenje. Jedino ozbiljno nevreme (npr. grad) može dovesti do prekida ili odlaganja, o čemu odlučuje glavni sudija.",
  },
  {
    q: "Da li publika može da prisustvuje?",
    a: "Da, ulaz je besplatan. Deca su dobrodošla, a parking je obezbeđen. Ulazak u pozicije timova dozvoljen je samo uz saglasnost organizatora.",
  },
  {
    q: "Koliko štapova tim može da koristi?",
    a: "Maksimalno 8 štapova po timu, raspoređenih na najviše 2 podmetača (rodpoda).",
  },
  {
    q: "Ko rešava sporove tokom turnira?",
    a: "Glavni sudija donosi konačnu odluku na licu mesta za svaki sporan slučaj.",
  },
]
---

<Layout
  title="ZenCarp — carp fishing turnir koji se gleda uživo"
  description="4 ekipe. 4 sata. Svaki ulov menja tabelu. Carp fishing turnir iz Vojvode Stepe, Banat."
  {navLinks}
  {cta}
>
  <div class={`min-h-screen bg-[#060a06] ${fontBody} text-[#e8e8e8]`}>
    <LiveBanner client:load baseUrl={BASE} />

    <!-- Hero -->
    <section
      class="relative flex min-h-[80vh] items-center justify-center overflow-hidden"
    >
      <video
        autoplay
        loop
        muted
        playsinline
        class="absolute inset-0 h-full w-full object-cover"
      >
        <source src={`${BASE}fishing.mp4`} type="video/mp4" />
      </video>
      <div class="absolute inset-0 bg-[#060a06]/65"></div>
      <div
        class="absolute inset-0 bg-gradient-to-b from-[#060a06]/30 via-transparent to-[#060a06]"
      >
      </div>

      <div class="relative z-10 mx-auto max-w-4xl px-5 text-center">
        <img
          src={`${BASE}zencarp_logo.png`}
          alt="ZenCarp"
          class="mx-auto mb-8 h-28 w-auto opacity-95 sm:h-36"
        />
        <div
          class={`mb-5 text-xs font-semibold uppercase tracking-[0.25em] text-[#c9a227] ${fontHeading}`}
        >
          Carp fishing turnir
        </div>
        <h1
          class={`mb-6 text-4xl font-bold leading-tight text-[#f0f0f0] sm:text-6xl ${fontHeading}`}
        >
          Četiri ekipe.<br />Četiri sata. Jedan pobednik.
        </h1>
        <p
          class="mx-auto mb-8 max-w-2xl text-lg leading-relaxed text-[#ccc] sm:text-xl"
        >
          Svaki ulov se meri pred kamerom i odmah ulazi u rezultat. Vojvoda
          Stepa, Banat.
        </p>
        <div
          class="flex flex-wrap items-center justify-center gap-5 text-xs text-[#888]"
        >
          <div>4 ekipe · 8 takmičara</div>
          <div class="h-3 w-px bg-[#1a2e1a]"></div>
          <div>4 sata</div>
          <div class="h-3 w-px bg-[#1a2e1a]"></div>
          <div>kotizacija 50€ · nagrada 200€</div>
        </div>
      </div>
    </section>

    <!-- O turniru -->
    <section id="o-turniru" class="px-5 py-24">
      <div class="mx-auto max-w-6xl">
        <div class="grid items-center gap-12 lg:grid-cols-2">
          <div>
            <div
              class={`mb-4 text-xs font-semibold uppercase tracking-[0.2em] text-[#c9a227] ${fontHeading}`}
            >
              ZenCarp
            </div>
            <h2
              class={`mb-6 text-3xl font-bold leading-tight text-[#f0f0f0] sm:text-4xl ${fontHeading}`}
            >
              Četiri sata sportske borbe.
            </h2>
            <div class="space-y-4 text-[15px] leading-relaxed text-[#aaa]">
              <p>
                Četiri ekipe, po dva takmičara. Svaka ekipa izvlači svoju
                poziciju na jezeru 100 × 100 metara i tu ostaje ceo turnir.
              </p>
              <p>
                Četiri sata traje borba za što veću ukupnu težinu ulova. Boduju
                se šaran i amur, svaka riba se meri pred kamerom i rezultat se
                odmah upisuje u tabelu.
              </p>
              <p>
                Kada vreme istekne, ekipa sa najvećom ukupnom težinom postaje
                ZenCarp šampion.
              </p>
            </div>

            <div
              class="mt-6 rounded-xl border border-[#1a2e1a] bg-[#0a0f0a] p-5"
            >
              <div
                class={`mb-2 text-xs font-semibold uppercase tracking-[0.15em] text-[#c9a227] ${fontHeading}`}
              >
                Jezero Vojvoda Stepa
              </div>
              <ul class="space-y-1 text-sm leading-relaxed text-[#aaa]">
                <li>• Šaran: 3–7 kg</li>
                <li>• Amur: 6 kg i više</li>
                <li>• Površina: 100 × 100 m</li>
              </ul>
            </div>

            <div class="mt-8 flex flex-wrap gap-4 text-xs text-[#888]">
              <div>4 ekipe</div>
              <div class="h-3 w-px bg-[#1a2e1a]"></div>
              <div>8 takmičara</div>
              <div class="h-3 w-px bg-[#1a2e1a]"></div>
              <div>4h pecanja</div>
            </div>
          </div>

          <div>
            <div class="overflow-hidden rounded-2xl bg-[#0a0f0a] p-3">
              <img
                src={`${BASE}mapa_jezera.png`}
                alt="Mapa ZenCarp jezera"
                class="h-auto w-full rounded-xl"
                style="object-fit: contain;"
              />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Karte – sada sa heading i subheading -->
    <section class="border-b border-[#111a11] px-5 py-14">
      <div class="mx-auto max-w-5xl">
        <div class="mb-10 text-center">
          <div
            class={`mb-3 text-xs font-semibold uppercase tracking-[0.2em] text-[#c9a227] ${fontHeading}`}
          >
            Vaša uloga
          </div>
          <h2
            class={`text-2xl font-bold text-[#f0f0f0] sm:text-3xl ${fontHeading}`}
          >
            Kako želite da budete deo ZenCarp-a?
          </h2>
          <p class="mt-2 text-sm text-[#888]">
            Odaberite svoj put – kao gledalac, takmičar ili partner.
          </p>
        </div>

        <div class="grid gap-4 sm:grid-cols-3">
          <a
            href="#uzivo"
            class="group rounded-xl bg-[#0a0f0a] p-6 transition-colors hover:bg-[#0d140d]"
          >
            <div
              class={`mb-2 text-xs font-semibold uppercase tracking-[0.15em] text-[#c9a227] ${fontHeading}`}
            >
              Dolazite kao gledalac
            </div>
            <p class="text-sm leading-relaxed text-[#999]">
              Ulaz je besplatan, parking obezbeđen, deca dobrodošla. Doživite
              atmosferu uživo.
            </p>
            <div
              class="mt-4 text-sm text-[#c9a227] transition-transform group-hover:translate-x-1"
            >
              Pogledajte prenos →
            </div>
          </a>

          <a
            href="#format"
            class="group rounded-xl bg-[#0a0f0a] p-6 transition-colors hover:bg-[#0d140d]"
          >
            <div
              class={`mb-2 text-xs font-semibold uppercase tracking-[0.15em] text-[#c9a227] ${fontHeading}`}
            >
              Želite da se takmičite
            </div>
            <p class="text-sm leading-relaxed text-[#999]">
              Saznajte pravila, format, kotizaciju i šta sve treba da ponesete.
            </p>
            <div
              class="mt-4 text-sm text-[#c9a227] transition-transform group-hover:translate-x-1"
            >
              Pravila i prijava →
            </div>
          </a>

          <a
            href="#partnerstvo"
            class="group rounded-xl bg-[#0a0f0a] p-6 transition-colors hover:bg-[#0d140d]"
          >
            <div
              class={`mb-2 text-xs font-semibold uppercase tracking-[0.15em] text-[#c9a227] ${fontHeading}`}
            >
              Zainteresovani ste za partnerstvo
            </div>
            <p class="text-sm leading-relaxed text-[#999]">
              Prisustvo u prenosu, na sadržaju i na samom događaju – saznajte
              više.
            </p>
            <div
              class="mt-4 text-sm text-[#c9a227] transition-transform group-hover:translate-x-1"
            >
              Saznajte više →
            </div>
          </a>
        </div>
      </div>
    </section>

    <!-- Format -->
    <section id="format" class="bg-[#080c08] px-5 py-24">
      <div class="mx-auto max-w-4xl">
        <div class="mb-12 text-center">
          <h2
            class={`text-3xl font-bold text-[#f0f0f0] sm:text-4xl ${fontHeading}`}
          >
            Format takmičenja
          </h2>
          <p
            class="mx-auto mt-4 max-w-2xl text-[15px] leading-relaxed text-[#888]"
          >
            Osnovna pravila. Kompletan pravilnik je{" "}
            <a
              href={`${BASE}pravilnik`}
              class="text-[#c9a227] underline underline-offset-4 hover:text-[#e8c94a]"
            >
              ovde
            </a>.
          </p>
        </div>

        <div class="space-y-6">
          <div class="rounded-xl bg-[#0a0f0a] p-6">
            <h3
              class={`mb-3 text-sm font-semibold text-[#c9a227] ${fontHeading}`}
            >
              Tim i pozicije
            </h3>
            <ul class="space-y-2 text-sm leading-relaxed text-[#aaa]">
              <li>
                • Tim čine dva punoletna takmičara – nema pojedinačnog nastupa.
              </li>
              <li>
                • Pozicije (P1–P4) se izvlače žrebom pre početka i fiksne su
                tokom turnira.
              </li>
            </ul>
          </div>

          <div class="rounded-xl bg-[#0a0f0a] p-6">
            <h3
              class={`mb-3 text-sm font-semibold text-[#c9a227] ${fontHeading}`}
            >
              Bodovanje i plasman
            </h3>
            <ul class="space-y-2 text-sm leading-relaxed text-[#aaa]">
              <li>
                • Boduju se isključivo šaran i amur – minimalna težina 500 g.
              </li>
              <li>
                • Pobednik je tim sa najvećom ukupnom težinom priznatih ulova
                nakon 4 sata.
              </li>
              <li>
                • U slučaju istog zbira, mesta se dele; za fizičku nagradu
                odlučuje žreb.
              </li>
            </ul>
          </div>

          <div class="rounded-xl bg-[#0a0f0a] p-6">
            <h3
              class={`mb-3 text-sm font-semibold text-[#c9a227] ${fontHeading}`}
            >
              Postupak merenja
            </h3>
            <ul class="space-y-2 text-sm leading-relaxed text-[#aaa]">
              <li>• Zagriz → poziv redara u roku od 60 sekundi.</li>
              <li>• Merenje pred kamerom → upis u tabelu (min. 500 g).</li>
              <li>• Povratak u vodu (catch & release).</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- Uživo -->
    <section id="uzivo" class="px-5 py-24">
      <div class="mx-auto max-w-6xl">
        <div class="mb-12 text-center">
          <div
            class={`mb-4 text-xs font-semibold uppercase tracking-[0.2em] text-[#c9a227] ${fontHeading}`}
          >
            Prenos uživo
          </div>
          <h2
            class={`text-3xl font-bold text-[#f0f0f0] sm:text-4xl ${fontHeading}`}
          >
            Plasman se menja pred tobom, u realnom vremenu.
          </h2>
          <p
            class="mx-auto mt-4 max-w-2xl text-[15px] leading-relaxed text-[#888]"
          >
            4 pozicione kamere, dron, reporter na terenu i 2 sudije-merioca
            prate svaki minut.
          </p>
        </div>

        <div class="grid gap-8 md:grid-cols-2">
          <div>
            <div class="overflow-hidden rounded-2xl bg-[#0a0f0a]">
              <video
                autoplay
                loop
                muted
                playsinline
                class="h-auto w-full"
                style="aspect-ratio: 16/9; object-fit: cover;"
              >
                <source src={`${BASE}rendered_overlay.mp4`} type="video/mp4" />
              </video>
            </div>
            <p class="mt-4 text-sm leading-relaxed text-[#888]">
              Plasman, vreme i težina vidljivi su tokom celog prenosa.
            </p>
          </div>

          <div>
            <div class="overflow-hidden rounded-2xl bg-[#0a0f0a] p-3">
              <img
                src={`${BASE}results_mobile.png`}
                alt="ZenCarp rezultati uživo"
                class="h-auto w-full rounded-xl"
                style="object-fit: contain;"
              />
            </div>
            <p class="mt-4 text-sm leading-relaxed text-[#888]">
              Rezultati su dostupni na telefonu i računaru u realnom vremenu.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section id="pitanja" class="bg-[#080c08] px-5 py-24">
      <div class="mx-auto max-w-3xl">
        <div class="mb-12 text-center">
          <div
            class={`mb-4 text-xs font-semibold uppercase tracking-[0.2em] text-[#c9a227] ${fontHeading}`}
          >
            Praktične informacije
          </div>
          <h2
            class={`text-3xl font-bold text-[#f0f0f0] sm:text-4xl ${fontHeading}`}
          >
            Često postavljana pitanja
          </h2>
        </div>

        <div class="divide-y divide-[#1a2e1a]/60 rounded-2xl bg-[#0a0f0a]">
          {
            faq.map((item) => (
              <details class="group px-6 py-5 first:rounded-t-2xl last:rounded-b-2xl">
                <summary
                  class={`flex cursor-pointer list-none items-center justify-between text-[15px] font-medium text-[#e8e8e8] ${fontHeading}`}
                >
                  {item.q}
                  <span class="ml-4 shrink-0 text-[#c9a227] transition-transform group-open:rotate-45">
                    +
                  </span>
                </summary>
                <p class="mt-3 text-sm leading-relaxed text-[#999]">{item.a}</p>
              </details>
            ))
          }
        </div>

        <div class="mt-8 text-center">
          <a
            href={`${BASE}pravilnik`}
            class={`inline-flex items-center gap-2 text-sm font-medium text-[#c9a227] underline underline-offset-4 hover:text-[#e8c94a] ${fontHeading}`}
          >
            Pročitaj kompletan pravilnik →
          </a>
        </div>
      </div>
    </section>

    <!-- Partnerstvo – vodi na partners stranicu -->
    <section id="partnerstvo" class="px-5 py-24">
      <div class="mx-auto max-w-4xl text-center">
        <div
          class={`mb-4 text-xs font-semibold uppercase tracking-[0.2em] text-[#c9a227] ${fontHeading}`}
        >
          Partnerstvo
        </div>
        <h2
          class={`mb-6 text-3xl font-bold text-[#f0f0f0] sm:text-4xl ${fontHeading}`}
        >
          Želite da podržite ZenCarp?
        </h2>
        <p
          class="mx-auto mb-10 max-w-2xl text-[15px] leading-relaxed text-[#aaa]"
        >
          Pregledajte sponzorske pakete, saznajte šta nudimo i kako vaš brend
          može biti deo našeg prenosa.
        </p>
        <a
          href={`${BASE}partners`}
          class={`inline-flex items-center justify-center gap-2 rounded-full bg-[#c9a227] px-8 py-3.5 text-sm font-medium text-[#0a0f0a] transition-colors hover:bg-[#d4b43a] ${fontHeading}`}
        >
          Saznajte više o partnerstvu
        </a>
      </div>
    </section>

    <!-- Prijava -->
    <section id="prijava" class="bg-[#080c08] px-5 py-24">
      <div class="mx-auto max-w-2xl text-center">
        <div
          class={`mb-4 text-xs font-semibold uppercase tracking-[0.2em] text-[#c9a227] ${fontHeading}`}
        >
          Takmičenje
        </div>
        <h2
          class={`mb-6 text-3xl font-bold text-[#f0f0f0] sm:text-4xl ${fontHeading}`}
        >
          Prijavite svoj tim.
        </h2>
        <p
          class="mx-auto mb-8 max-w-xl text-[15px] leading-relaxed text-[#888]"
        >
          Tim čine dva punoletna takmičara. Kotizacija se plaća u gotovini na
          dan turnira, prilikom prijave. Pre početka potpisuju se izjava o
          odricanju odgovornosti i saglasnost za snimanje.
        </p>
        <div class="mb-8 text-sm text-[#777]">
          Kotizacija
          <span class="mx-2 text-[#333]">·</span>
          <span class="font-medium text-[#e0e0e0]">50 EUR po ekipi</span>
          <span class="mx-3 text-[#333]">·</span>
          Nagrada
          <span class="mx-2 text-[#333]">·</span>
          <span class="font-medium text-[#e0e0e0]">200 EUR</span>
        </div>
        <div
          class="flex flex-col items-center justify-center gap-4 sm:flex-row"
        >
          <a
            href="mailto:prijava@zencarp.rs"
            class={`inline-flex items-center gap-2 rounded-full bg-[#c9a227] px-8 py-3.5 text-sm font-medium text-[#0a0f0a] transition-colors hover:bg-[#d4b43a] ${fontHeading}`}
          >
            Prijavi ekipu
          </a>
          <a
            href={`${BASE}pravilnik`}
            class={`inline-flex items-center gap-2 rounded-full border border-[#1a2e1a] bg-[#0a0f0a] px-8 py-3.5 text-sm font-medium text-[#e0e0e0] transition-colors hover:border-[#c9a227]/40 hover:text-[#c9a227] ${fontHeading}`}
          >
            Pravilnik
          </a>
        </div>
      </div>
    </section>
  </div>
</Layout>
