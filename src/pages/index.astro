<style>
  .live-dot {
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: #e0473a;
    box-shadow: 0 0 0 0 rgba(224, 71, 58, 0.6);
    animation: pulse 1.8s ease-out infinite;
  }
  @keyframes pulse {
    0% {
      box-shadow: 0 0 0 0 rgba(224, 71, 58, 0.55);
    }
    70% {
      box-shadow: 0 0 0 8px rgba(224, 71, 58, 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(224, 71, 58, 0);
    }
  }
  .ticker {
    animation: scroll-left 28s linear infinite;
  }
  .ticker-reverse {
    animation: scroll-left 34s linear infinite;
  }
  @keyframes scroll-left {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }
  .bar {
    width: 0%;
    transition: width 1.1s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .leaderboard-row.is-visible .bar {
    width: var(--bar-width);
  }
  .reveal {
    opacity: 0;
    transform: translateY(16px);
    transition:
      opacity 0.6s ease,
      transform 0.6s ease;
  }
  .reveal.is-visible {
    opacity: 1;
    transform: translateY(0);
  }
  @media (prefers-reduced-motion: reduce) {
    .live-dot,
    .ticker,
    .ticker-reverse,
    .bar,
    .reveal {
      animation: none !important;
      transition: none !important;
    }
    .reveal {
      opacity: 1;
      transform: none;
    }
    .bar {
      width: var(--bar-width);
    }
  }
</style>

<script>
  const io = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) {
          entry.target.classList.add("is-visible")
          io.unobserve(entry.target)
        }
      }
    },
    { threshold: 0.2 }
  )
  document
    .querySelectorAll(".reveal, .leaderboard-row")
    .forEach((el) => io.observe(el))
</script>
