---
// index.astro — ZenCarp landing page
import Layout from "@/layouts/main.astro"

const BASE = import.meta.env.BASE_URL
const fontHeading = "font-[family-name:var(--font-poppins)]"
const fontBody = "font-[family-name:var(--font-inter)]"
const fontData = "font-[family-name:var(--font-oswald)]"

const tickerItems = [
  "VOJVODA STEPA, BANAT",
  "ČETIRI EKIPE",
  "PET SATI NA VODI",
  "ŠARAN I AMUR",
  "PRVI PUT OVE GODINE",
]

const heroStats = [
  { label: "EKIPE", value: "4" },
  { label: "TRAJANJE", value: "5H" },
  { label: "KOTIZACIJA", value: "50€" },
  { label: "NAGRADA", value: "200€" },
]

const kakoIde = [
  {
    n: "01",
    title: "Žreb pozicija",
    desc: "Svaka ekipa izvuče poziciju na jezeru pre početka. Tu ostaje do kraja — nema premeštanja.",
  },
  {
    n: "02",
    title: "Pet sati pecanja",
    desc: "Dvoje po ekipi, jedna stolica do druge. Ko šta ulovi, meri se na licu mesta.",
  },
  {
    n: "03",
    title: "Vaganje i povratak",
    desc: "Šaran ili amur — izvuče se, izmeri pred svima, i odmah nazad u vodu.",
  },
  {
    n: "04",
    title: "Tabela do poslednjeg minuta",
    desc: "Pobeđuje ekipa sa najvećom ukupnom težinom. Sve se broji, do samog kraja.",
  },
]

const uzivo = [
  {
    title: "Kamera po ekipi",
    desc: "Ideja je da svaka pozicija ima svoju kameru — da se vidi i čekanje, ne samo ulov.",
  },
  {
    title: "Neko sa mikrofonom",
    desc: "Obilazi jezero, pita ekipe kako im ide, hvata to dok se dešava.",
  },
  {
    title: "Tabela uživo",
    desc: "Ko vodi, za koliko, i ko je poslednji ulovio — vidi se odmah.",
  },
  {
    title: "Komentator",
    desc: "Neko prati ceo dan i objašnjava šta se menja i zašto.",
  },
]

const contentFormats = [
  "REELS",
  "KRATAK VIDEO",
  "NAJBOLJI TRENUCI",
  "IZA KULISA",
  "SNIMCI DRONOM",
  "EKIPE IZBLIZA",
]

const sponsorTouchpoints = [
  "Prenos uživo",
  "Grafike turnira",
  "Društvene mreže",
  "Video sadržaj",
  "Vidljivost na jezeru",
]

const audienceTags = [
  "Ljubitelji ribolova",
  "Porodice",
  "Ljudi iz okoline",
  "Ljubitelji sporta",
  "Radoznali",
]

const eventInfo = [
  { label: "Lokacija", value: "Vojvoda Stepa, Banat" },
  { label: "Format", value: "4 ekipe, po 2 takmičara" },
  { label: "Trajanje", value: "5 sati na vodi" },
  { label: "Riba", value: "Šaran i amur" },
  { label: "Kotizacija", value: "50 € po ekipi" },
  { label: "Nagrada", value: "200 € pobedniku" },
]

const leaderboard = [
  { pos: "P1", weight: 8.4 },
  { pos: "P2", weight: 6.1 },
  { pos: "P3", weight: 4.8 },
  { pos: "P4", weight: 2.2 },
]
const maxWeight = Math.max(...leaderboard.map((t) => t.weight))
---

<Layout
  title="ZEN CARP — turnir u pecanju šarana, Banat"
  description="Četiri ekipe, jedno jezero, pet sati. ZenCarp je turnir u pecanju šarana i amura na jezeru Vojvoda Stepa u Banatu."
>
  <div class={`min-h-screen bg-[#060a06] ${fontBody} text-[#e8e8e8]`}>
    <!-- Ticker -->
    <div class="overflow-hidden border-b border-[#111a11] bg-[#080c08] py-2">
      <div
        class={`ticker flex w-max gap-10 whitespace-nowrap text-[11px] font-medium uppercase tracking-[0.2em] text-[#c9a227] ${fontData}`}
      >
        {
          [...Array(2)].map(() =>
            tickerItems.map((item) => (
              <span class="flex items-center gap-10">
                {item}
                <span class="text-[#333]">/</span>
              </span>
            ))
          )
        }
      </div>
    </div>

    <!-- HERO -->
    <section
      class="relative flex min-h-[92vh] flex-col justify-end overflow-hidden"
    >
      <video
        autoplay
        loop
        muted
        playsinline
        class="absolute inset-0 h-full w-full object-cover"
        poster={`${BASE}final_lake.jpeg`}
      >
        <source src={`${BASE}fishing.mp4`} type="video/mp4" />
      </video>
      <div
        class="absolute inset-0 bg-gradient-to-t from-[#060a06] via-[#060a06]/75 to-[#060a06]/40"
      >
      </div>

      <div class="relative z-10 mx-auto w-full max-w-6xl px-5 pt-32 pb-14">
        <div class="mb-6 flex items-center gap-3">
          <span class="live-dot"></span>
          <span
            class={`text-xs font-semibold uppercase tracking-[0.3em] text-[#e8e8e8] ${fontData}`}
          >
            Banat, Vojvoda Stepa
          </span>
        </div>

        <h1
          class={`text-[16vw] font-bold leading-[0.85] text-[#f0f0f0] sm:text-[9rem] ${fontHeading}`}
        >
          ZEN<span class="text-[#c9a227]">CARP</span>
        </h1>

        <p class="mt-7 max-w-lg text-lg leading-relaxed text-[#ccc] sm:text-xl">
          Četiri ekipe, jedno jezero, pet sati da uloviš najviše kilograma.
          Turnir u pecanju šarana kakav u Banatu do sad nismo imali.
        </p>

        <div class="mt-9 flex flex-wrap items-center gap-4">
          <a
            href="#kako-ide"
            class={`rounded-full bg-[#c9a227] px-8 py-3.5 text-sm font-medium text-[#0a0f0a] transition-colors hover:bg-[#d4b43a] ${fontHeading}`}
          >
            Kako funkcioniše
          </a>
          <a
            href="#enter"
            class={`rounded-full border border-[#2a3a2a] px-8 py-3.5 text-sm font-medium text-[#e0e0e0] transition-colors hover:border-[#c9a227]/50 hover:text-[#c9a227] ${fontHeading}`}
          >
            Prijavi ekipu
          </a>
        </div>

        <div
          class={`mt-14 grid grid-cols-2 gap-x-8 gap-y-6 border-t border-[#1a2e1a] pt-6 sm:flex sm:flex-wrap sm:gap-x-12 ${fontData}`}
        >
          {
            heroStats.map((s) => (
              <div>
                <div class="text-[10px] tracking-[0.25em] text-[#777] uppercase">
                  {s.label}
                </div>
                <div class="mt-1 text-2xl font-medium text-[#f0f0f0]">
                  {s.value}
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- PRIČA -->
    <section class="reveal px-5 py-24">
      <div class="mx-auto grid max-w-6xl gap-14 lg:grid-cols-[1fr_1fr]">
        <div>
          <div
            class={`mb-4 text-xs font-semibold uppercase tracking-[0.25em] text-[#c9a227] ${fontData}`}
          >
            Zašto ZenCarp
          </div>
          <h2
            class={`mb-6 text-3xl font-bold leading-tight text-[#f0f0f0] sm:text-4xl ${fontHeading}`}
          >
            Pecanje, samo što sad neko pobeđuje.
          </h2>
          <div class="space-y-4 text-[15px] leading-relaxed text-[#aaa]">
            <p>
              Ko je nekad pecao šarana zna da nije samo sedenje pored vode. Bira
              se pozicija, bira se mamac, bira se trenutak — pogrešiš i dan
              prođe bez ulova.
            </p>
            <p>
              ZenCarp to isto pecanje pretvara u takmičenje. Fiksna pozicija,
              ograničeno vreme, jedna vaga koja na kraju odlučuje ko je bio
              bolji tog dana.
            </p>
            <p>
              Prvi put se održava na jezeru Vojvoda Stepa u Banatu — četiri
              ekipe, jedna nagrada, i pravo da posle kažeš da si pobedio.
            </p>
          </div>
        </div>

        <div
          class="flex items-center justify-center overflow-hidden rounded-xl border border-[#1a2e1a] bg-[#0a0f0a]"
        >
          <img
            src={`${BASE}final_lake.jpeg`}
            alt="Jezero Vojvoda Stepa u Banatu, mesto održavanja turnira ZenCarp"
            width="1200"
            height="900"
            loading="lazy"
            class="h-full w-full object-cover"
          />
        </div>
      </div>
    </section>

    <!-- KAKO IDE -->
    <section
      id="kako-ide"
      class="reveal border-y border-[#111a11] bg-[#080c08] px-5 py-24"
    >
      <div class="mx-auto max-w-6xl">
        <div class="mb-14 max-w-2xl">
          <div
            class={`mb-4 text-xs font-semibold uppercase tracking-[0.25em] text-[#c9a227] ${fontData}`}
          >
            Format
          </div>
          <h2
            class={`mb-5 text-3xl font-bold leading-tight text-[#f0f0f0] sm:text-4xl ${fontHeading}`}
          >
            Kako ide takmičenje.
          </h2>
        </div>

        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
          {
            kakoIde.map((k) => (
              <div class="rounded-xl border border-[#1a2e1a] bg-[#0a0f0a] p-6">
                <div
                  class={`text-3xl font-semibold text-[#c9a227] ${fontData}`}
                >
                  {k.n}
                </div>
                <div
                  class={`mt-3 text-sm font-medium tracking-[0.05em] text-[#e8e8e8] uppercase ${fontData}`}
                >
                  {k.title}
                </div>
                <div class="mt-2 text-sm leading-relaxed text-[#999]">
                  {k.desc}
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- UŽIVO -->
    <section id="live" class="reveal px-5 py-24">
      <div class="mx-auto max-w-6xl">
        <div class="mb-14 max-w-2xl">
          <div
            class={`mb-4 text-xs font-semibold uppercase tracking-[0.25em] text-[#c9a227] ${fontData}`}
          >
            Prenos
          </div>
          <h2
            class={`mb-5 text-3xl font-bold leading-tight text-[#f0f0f0] sm:text-4xl ${fontHeading}`}
          >
            Hoćemo da se ovo gleda, ne samo da se odigra.
          </h2>
          <p class="text-[15px] leading-relaxed text-[#999]">
            Ideja je jednostavna — kamera na svaku poziciju, tabela koja se
            menja iz minuta u minut, i neko ko sve to prati i priča šta se
            dešava.
          </p>
        </div>

        <div class="grid gap-10 lg:grid-cols-[1.1fr_1fr]">
          <div
            class="relative aspect-[16/9] overflow-hidden rounded-xl border border-[#1a2e1a] bg-[#060a06]"
          >
            <video
              autoplay
              loop
              muted
              playsinline
              class="h-full w-full object-contain"
            >
              <source
                src={`${BASE}ZenCarpOverlay.mp4?version=2`}
                type="video/mp4"
              />
            </video>
          </div>

          <div class="divide-y divide-[#1a2e1a]">
            {
              uzivo.map((f) => (
                <div class="flex items-start gap-4 py-4">
                  <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-[#c9a227]" />
                  <div>
                    <div
                      class={`text-sm font-medium tracking-[0.1em] text-[#e8e8e8] uppercase ${fontData}`}
                    >
                      {f.title}
                    </div>
                    <div class="mt-1 text-[13px] leading-relaxed text-[#888]">
                      {f.desc}
                    </div>
                  </div>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <!-- APLIKACIJA -->
    <section
      id="mobile"
      class="reveal border-y border-[#111a11] bg-[#080c08] px-5 py-24"
    >
      <div class="mx-auto grid max-w-6xl items-center gap-14 lg:grid-cols-2">
        <div class="order-2 lg:order-1">
          <div
            class={`mb-4 text-xs font-semibold uppercase tracking-[0.25em] text-[#c9a227] ${fontData}`}
          >
            Ako nisi na jezeru
          </div>
          <h2
            class={`mb-6 text-3xl font-bold leading-tight text-[#f0f0f0] sm:text-4xl ${fontHeading}`}
          >
            Prati tabelu sa telefona.
          </h2>
          <p class="mb-6 max-w-md text-[15px] leading-relaxed text-[#aaa]">
            Ne moraš da budeš pored vode da bi znao ko vodi. Aplikacija bi se
            ažurirala čim se neki ulov izmeri i potvrdi.
          </p>
          <ul class="space-y-2 text-sm text-[#999]">
            <li class="flex items-center gap-2">
              <span class="h-1 w-1 rounded-full bg-[#c9a227]"></span>Trenutni
              plasman
            </li>
            <li class="flex items-center gap-2">
              <span class="h-1 w-1 rounded-full bg-[#c9a227]"></span>Svaki ulov,
              po ekipi
            </li>
            <li class="flex items-center gap-2">
              <span class="h-1 w-1 rounded-full bg-[#c9a227]"></span>Ažurno, bez
              čekanja
            </li>
          </ul>
        </div>

        <div class="order-1 flex justify-center lg:order-2">
          <div
            class="relative w-[320px] overflow-hidden rounded-[2.5rem] border-4 border-[#111a11] bg-[#0a0f0a] shadow-2xl shadow-black/50 sm:w-[360px] lg:w-[400px]"
          >
            <div
              class="absolute top-0 left-1/2 z-10 h-6 w-32 -translate-x-1/2 rounded-b-2xl bg-[#111a11]"
            >
            </div>
            <video
              src={`${BASE}ZenCarpPhone.mp4`}
              loop
              muted
              playsinline
              autoplay
              class="aspect-[9/16] h-auto w-full object-cover"></video>
          </div>
        </div>
      </div>
    </section>

    <!-- TABELA -->
    <section id="competition" class="reveal px-5 py-24">
      <div class="mx-auto max-w-4xl">
        <div class="mb-4 flex items-center justify-between">
          <div
            class={`text-xs font-semibold uppercase tracking-[0.25em] text-[#c9a227] ${fontData}`}
          >
            Primer tabele
          </div>
          <div
            class={`text-[10px] uppercase tracking-[0.2em] text-[#666] ${fontData}`}
          >
            Ovako bi izgledao prikaz
          </div>
        </div>
        <h2
          class={`mb-3 text-3xl font-bold leading-tight text-[#f0f0f0] sm:text-4xl ${fontHeading}`}
        >
          Kilogrami odlučuju, ništa drugo.
        </h2>
        <p class="mb-12 max-w-xl text-[15px] leading-relaxed text-[#999]">
          Sabira se ukupna težina svih ulova po ekipi. Ko ima najviše na kraju
          petog sata, taj je pobednik.
        </p>

        <div class="space-y-3">
          {
            leaderboard.map((t) => (
              <div class="leaderboard-row grid grid-cols-[3rem_1fr_5rem] items-center gap-4 sm:grid-cols-[3.5rem_1fr_6rem]">
                <div
                  class={`text-2xl font-semibold text-[#c9a227] ${fontData}`}
                >
                  {t.pos}
                </div>
                <div class="h-9 overflow-hidden rounded bg-[#0a0f0a]">
                  <div
                    class="bar h-full rounded bg-gradient-to-r from-[#8a6d1c] to-[#c9a227]"
                    style={`--bar-width:${Math.round((t.weight / maxWeight) * 100)}%`}
                  />
                </div>
                <div
                  class={`text-right text-sm font-medium text-[#e8e8e8] ${fontData}`}
                >
                  {t.weight.toFixed(1)} KG
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- JEZERO -->
    <section
      id="jezero"
      class="reveal border-y border-[#111a11] bg-[#080c08] px-5 py-24"
    >
      <div class="mx-auto grid max-w-6xl items-center gap-14 lg:grid-cols-2">
        <div>
          <div
            class={`mb-4 text-xs font-semibold uppercase tracking-[0.25em] text-[#c9a227] ${fontData}`}
          >
            Lokacija
          </div>
          <h2
            class={`mb-6 text-3xl font-bold leading-tight text-[#f0f0f0] sm:text-4xl ${fontHeading}`}
          >
            Vojvoda Stepa, Banat.
          </h2>
          <p class="text-[15px] leading-relaxed text-[#aaa]">
            Tu se igra sve. Četiri fiksne pozicije oko jednog jezera, gde ima i
            šarana i amura, i gde svako mora sam da smisli kako da pretekne
            ostale.
          </p>
        </div>
        <div class="overflow-hidden rounded-xl border border-[#1a2e1a]">
          <img
            src={`${BASE}final_lake.jpeg`}
            alt="Pogled na jezero Vojvoda Stepa u Banatu, mesto turnira ZenCarp"
            width="1200"
            height="900"
            loading="lazy"
            class="h-full w-full object-cover"
          />
        </div>
      </div>
    </section>

    <!-- SADRŽAJ -->
    <section class="reveal py-24">
      <div class="mx-auto max-w-6xl px-5">
        <div class="mb-10 max-w-2xl">
          <div
            class={`mb-4 text-xs font-semibold uppercase tracking-[0.25em] text-[#c9a227] ${fontData}`}
          >
            Posle turnira
          </div>
          <h2
            class={`mb-5 text-3xl font-bold leading-tight text-[#f0f0f0] sm:text-4xl ${fontHeading}`}
          >
            Snimamo sve, ne samo ulove.
          </h2>
          <p class="text-[15px] leading-relaxed text-[#999]">
            Ceo dan ide na kameru — ekipe, jezero, momenti pre i posle ulova. To
            posle deo po deo izlazi na mreže.
          </p>
        </div>
      </div>
      <div class="overflow-hidden border-y border-[#111a11] bg-[#0a0f0a] py-5">
        <div
          class={`ticker-reverse flex w-max gap-12 whitespace-nowrap text-sm font-medium uppercase tracking-[0.2em] text-[#555] ${fontData}`}
        >
          {
            [...Array(2)].map(() =>
              contentFormats.map((c) => (
                <span class="flex items-center gap-12">
                  {c}
                  <span class="text-[#c9a227]">●</span>
                </span>
              ))
            )
          }
        </div>
      </div>
    </section>

    <!-- SPONZORI -->
    <section
      id="sponsors"
      class="reveal border-y border-[#111a11] bg-[#080c08] px-5 py-24"
    >
      <div class="mx-auto max-w-4xl text-center">
        <div
          class={`mb-4 text-xs font-semibold uppercase tracking-[0.25em] text-[#c9a227] ${fontData}`}
        >
          Sponzori
        </div>
        <h2
          class={`mb-6 text-3xl font-bold leading-tight text-[#f0f0f0] sm:text-4xl ${fontHeading}`}
        >
          Ima mesta i za tvoj brend.
        </h2>
        <p
          class="mx-auto mb-10 max-w-xl text-[15px] leading-relaxed text-[#aaa]"
        >
          Prenos, tabela, objave na mrežama, prisustvo na samom jezeru — sve to
          nudimo onima koji požele da podrže turnir.
        </p>

        <div class="mb-10 flex flex-wrap justify-center gap-3">
          {
            sponsorTouchpoints.map((t) => (
              <span
                class={`rounded-full border border-[#1a2e1a] px-4 py-1.5 text-xs tracking-[0.1em] text-[#c9a227] uppercase ${fontData}`}
              >
                {t}
              </span>
            ))
          }
        </div>

        <a
          href="mailto:zencarp@outlook.com"
          class={`inline-flex items-center gap-2 rounded-full bg-[#c9a227] px-8 py-3.5 text-sm font-medium text-[#0a0f0a] transition-colors hover:bg-[#d4b43a] ${fontHeading}`}
        >
          Javi se
        </a>
      </div>
    </section>

    <!-- ZA KOGA JE -->
    <section class="reveal px-5 py-24">
      <div class="mx-auto max-w-4xl">
        <div
          class={`mb-4 text-xs font-semibold uppercase tracking-[0.25em] text-[#c9a227] ${fontData}`}
        >
          Za koga je ovo
        </div>
        <h2
          class={`mb-6 max-w-2xl text-3xl font-bold leading-tight text-[#f0f0f0] sm:text-4xl ${fontHeading}`}
        >
          Ne moraš da pecaš da bi došao.
        </h2>
        <p class="mb-8 max-w-xl text-[15px] leading-relaxed text-[#aaa]">
          Ulaz je slobodan, ima gde da se parkira, deca su dobrodošla. Ko ne
          može da dođe, prati tabelu i prenos od kuće.
        </p>
        <div class="flex flex-wrap gap-3">
          {
            audienceTags.map((tag) => (
              <span class="rounded-full bg-[#0a0f0a] px-4 py-1.5 text-xs text-[#999]">
                {tag}
              </span>
            ))
          }
        </div>
      </div>
    </section>

    <!-- DETALJI -->
    <section
      id="info"
      class="reveal border-y border-[#111a11] bg-[#080c08] px-5 py-24"
    >
      <div class="mx-auto max-w-3xl">
        <div
          class={`mb-4 text-xs font-semibold uppercase tracking-[0.25em] text-[#c9a227] ${fontData}`}
        >
          Detalji
        </div>
        <h2
          class={`mb-10 text-3xl font-bold leading-tight text-[#f0f0f0] sm:text-4xl ${fontHeading}`}
        >
          Sve što treba da znaš.
        </h2>
        <div class="divide-y divide-[#1a2e1a] border-y border-[#1a2e1a]">
          {
            eventInfo.map((row) => (
              <div class="flex items-center justify-between py-4">
                <span
                  class={`text-xs tracking-[0.2em] text-[#777] uppercase ${fontData}`}
                >
                  {row.label}
                </span>
                <span class="text-[15px] font-medium text-[#e8e8e8]">
                  {row.value}
                </span>
              </div>
            ))
          }
        </div>
        <p class="mt-6 text-xs text-[#666]">
          Pravila i način bodovanja su u <a
            href={`${BASE}pravilnik`}
