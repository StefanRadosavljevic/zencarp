---
// index.astro — ZenCarp landing page
// Broadcast-first redesign: F1 timing-tower graphics meet a lake in Banat.
import Layout from "@/layouts/main.astro"

const BASE = import.meta.env.BASE_URL
const fontHeading = "font-[family-name:var(--font-poppins)]" // brand voice — headlines, statements
const fontBody = "font-[family-name:var(--font-inter)]" // reading voice — paragraphs
const fontData = "font-[family-name:var(--font-oswald)]" // broadcast voice — labels, numbers, live data

const tickerItems = [
  "ČETIRI EKIPE, JEDNO JEZERO",
  "SVAKI ULOV MENJA PLASMAN",
  "IDEJA U NASTAJANJU",
  "VOJVODA STEPA, BANAT",
  "PET SATI NA VODI",
]

const heroStats = [
  { label: "EKIPE", value: "04" },
  { label: "POZICIJE", value: "FIKSNE" },
  { label: "NA VODI", value: "05H" },
  { label: "POBEDNIK NOSI", value: "€200" },
]

const conceptFacts = [
  {
    label: "Ekipe",
    value: "4",
    detail: "Po dva takmičara u ekipi, jedna pozicija za ceo dan.",
  },
  {
    label: "Kamere",
    value: "5",
    detail:
      "Plan je da postoje četiri stalne pozicije i jedna terenska kamera u pokretu.",
  },
  {
    label: "Plasman",
    value: "Uživo",
    detail: "Svaki ulov trebalo bi odmah da menja poredak na tabeli.",
  },
  {
    label: "Komentar",
    value: "Uživo",
    detail: "Komentator bi pratio svaku promenu i objašnjavao šta se dešava.",
  },
  {
    label: "Produkcija",
    value: "U pripremi",
    detail:
      "Grafika, ponovljeni snimci i smena kadrova — dok se turnir dešava.",
  },
  {
    label: "Objave na mrežama",
    value: "Tokom dana",
    detail: "Sadržaj bi išao na mreže direktno sa jezera, dok turnir traje.",
  },
]

const liveFeed = [
  {
    title: "Pozicije kamera",
    desc: "Plan je da četiri stalne kamere, po jedna za svaku ekipu, prate i čekanje i borbu s ribom.",
  },
  {
    title: "Terenski reporter",
    desc: "Kamera i mikrofon bi obilazili pozicije i hvatali reakcije i izjave sa terena.",
  },
  {
    title: "Ulovi uživo",
    desc: "Svaka riba se izvadi mrežom, izmeri pred kamerom i vrati u vodu.",
  },
  {
    title: "Grafika plasmana",
    desc: "Plasman i zaostatak za prvim mestom bili bi prikazani na ekranu tokom prenosa.",
  },
  {
    title: "Komentar",
    desc: "Komentator bi objašnjavao taktiku, pozicioniranje i tok igre u toku dešavanja.",
  },
  {
    title: "Najave promena",
    desc: "Svaka promena lidera trebalo bi odmah da se najavi tokom prenosa.",
  },
]

const contentFormats = [
  "REELS",
  "KRATKI VIDEO",
  "NAJZANIMLJIVIJI TRENUCI",
  "IZA KULISA",
  "SNIMCI DRONOM",
  "TRENUCI SA EKIPAMA",
  "SPONZORSKI SADRŽAJ",
  "PONOVLJENI ULOVI",
]

const sponsorTouchpoints = [
  "Prenos uživo",
  "Grafike turnira",
  "Društvene mreže",
  "Kratki video sadržaj",
  "Vidljivost na licu mesta",
  "Brendirani sadržaj",
]

const audienceTags = [
  "Ljubitelji ribolova",
  "Porodice",
  "Lokalni posetioci",
  "Takmičari",
  "Ljubitelji sporta",
  "Gledaoci koji prvi put prate",
]

const eventInfo = [
  { label: "Lokacija", value: "Vojvoda Stepa, Banat" },
  { label: "Format", value: "4 ekipe · po 2 takmičara" },
  { label: "Trajanje", value: "5 sati na vodi" },
  { label: "Vrste ribe", value: "Šaran i amur" },
  { label: "Kotizacija", value: "50 € po ekipi" },
  { label: "Nagrada", value: "200 € pobedničkoj ekipi" },
]

const leaderboard = [
  { pos: "P1", weight: 8.4 },
  { pos: "P2", weight: 6.1 },
  { pos: "P3", weight: 4.8 },
  { pos: "P4", weight: 2.2 },
]
const maxWeight = Math.max(...leaderboard.map((t) => t.weight))
---

<Layout
  title="ZEN CARP — Ribolovno takmičenje uživo"
  description="Četiri ekipe. Jedno jezero. Ideja o prenosu uživo građenom oko svakog ulova. ZenCarp je ribolovno takmičenje sa jezera Vojvoda Stepa, Banat."
>
  <div class={`min-h-screen bg-[#060a06] ${fontBody} text-[#e8e8e8]`}>
    <!-- Ticker -->
    <div class="overflow-hidden border-b border-[#111a11] bg-[#080c08] py-2">
      <div
        class={`ticker flex w-max gap-10 whitespace-nowrap text-[11px] font-medium uppercase tracking-[0.2em] text-[#c9a227] ${fontData}`}
      >
        {
          [...Array(2)].map(() =>
            tickerItems.map((item) => (
              <span class="flex items-center gap-10">
                {item}
                <span class="text-[#333]">/</span>
              </span>
            ))
          )
        }
      </div>
    </div>

    <!-- HERO -->
    <section
      class="relative flex min-h-[92vh] flex-col justify-end overflow-hidden"
    >
      <video
        autoplay
        loop
        muted
        playsinline
        class="absolute inset-0 h-full w-full object-cover"
      >
        <source src={`${BASE}fishing.mp4`} type="video/mp4" />
      </video>
      <div
        class="absolute inset-0 bg-gradient-to-t from-[#060a06] via-[#060a06]/75 to-[#060a06]/40"
      >
      </div>

      <div class="relative z-10 mx-auto w-full max-w-6xl px-5 pt-32 pb-14">
        <div class="mb-6 flex items-center gap-3">
          <span class="live-dot"></span>
          <span
            class={`text-xs font-semibold uppercase tracking-[0.3em] text-[#e8e8e8] ${fontData}`}
          >
            Ideja za ribolovno takmičenje
          </span>
        </div>

        <h1
          class={`text-[16vw] font-bold leading-[0.85] text-[#f0f0f0] sm:text-[9rem] ${fontHeading}`}
        >
          ZEN<span class="text-[#c9a227]">CARP</span>
        </h1>

        <p
          class="mt-8 max-w-xl text-[15px] leading-relaxed text-[#ccc] sm:text-lg"
        >
          Četiri ekipe. Jedno jezero. Četiri sata borbe za svaki ulov, dok mi to
          pratimo kamerama, komentarom i plasmanom uživo — kao pravi sportski
          prenos.
        </p>

        <div class="mt-9 flex flex-wrap items-center gap-4">
          <a
            href="#live"
            class={`rounded-full bg-[#c9a227] px-8 py-3.5 text-sm font-medium text-[#0a0f0a] transition-colors hover:bg-[#d4b43a] ${fontHeading}`}
          >
            Kako funkcioniše
          </a>
          <a
            href="#enter"
            class={`rounded-full border border-[#2a3a2a] px-8 py-3.5 text-sm font-medium text-[#e0e0e0] transition-colors hover:border-[#c9a227]/50 hover:text-[#c9a227] ${fontHeading}`}
          >
            Prijavi ekipu
          </a>
        </div>

        <div
          class={`mt-14 grid grid-cols-2 gap-x-8 gap-y-6 border-t border-[#1a2e1a] pt-6 sm:flex sm:flex-wrap sm:gap-x-12 ${fontData}`}
        >
          {
            heroStats.map((s) => (
              <div>
                <div class="text-[10px] tracking-[0.25em] text-[#777] uppercase">
                  {s.label}
                </div>
                <div class="mt-1 text-2xl font-medium text-[#f0f0f0]">
                  {s.value}
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- CONCEPT -->
    <section class="reveal px-5 py-24">
      <div class="mx-auto grid max-w-6xl gap-14 lg:grid-cols-[1fr_1fr]">
        <div>
          <div
            class={`mb-4 text-xs font-semibold uppercase tracking-[0.25em] text-[#c9a227] ${fontData}`}
          >
            Koncept
          </div>
          <h2
            class={`mb-6 text-3xl font-bold leading-tight text-[#f0f0f0] sm:text-4xl ${fontHeading}`}
          >
            Ribolov predstavljen kao sportski prenos.
          </h2>
          <div class="space-y-4 text-[15px] leading-relaxed text-[#aaa]">
            <p>
              Ribolov na šarana obično traži strpljenje i mir — dugo čekanje i
              tih ambijent, sa malo toga za nekoga ko posmatra sa strane. Mi
              želimo da probamo nešto drugačije: da to isto čekanje predstavimo
              kao pravo takmičenje, sa kamerama, komentarom i plasmanom koji se
              menja iz minuta u minut.
            </p>
            <p>
              Ne pokušavamo da izmislimo novi sport, već da postojeći format
              ribolovnog takmičenja opremimo alatima koje ljudi prepoznaju iz
              sportskih prenosa — praćenje uživo, jasan plasman i komentar koji
              objašnjava šta se dešava, u trenutku kad se dešava.
            </p>
            <p>
              Zašto ovo radimo? Zato što mislimo da ribolov ima potencijal da
              bude zanimljiv i onima koji ne pecaju — samo mu treba format koji
              to pokaže. ZenCarp je naš pokušaj da tu ideju isprobamo, počev od
              jednog turnira na jednom jezeru.
            </p>
          </div>
        </div>

        <div
          class="flex items-center justify-center overflow-hidden rounded-xl border border-[#1a2e1a] bg-[#0a0f0a]"
        >
          <img
            src={`${BASE}final_lake.jpeg`}
            alt="Mapa jezera"
            class="h-full w-full object-cover"
          />
        </div>
      </div>
    </section>

    <!-- LIVE EXPERIENCE -->
    <section
      id="live"
      class="reveal border-y border-[#111a11] bg-[#080c08] px-5 py-24"
    >
      <div class="mx-auto max-w-6xl">
        <div class="mb-14 max-w-2xl">
          <div
            class={`mb-4 text-xs font-semibold uppercase tracking-[0.25em] text-[#c9a227] ${fontData}`}
          >
            Uživo
          </div>
          <h2
            class={`mb-5 text-3xl font-bold leading-tight text-[#f0f0f0] sm:text-4xl ${fontHeading}`}
          >
            Zamišljeno da se prati kao sport, ne samo da se peca.
          </h2>
          <p class="text-[15px] leading-relaxed text-[#999]">
            ZenCarp je zamišljen kao sportski prenos — sa više kamera, plasmanom
            koji se ažurira iz minuta u minut i komentatorom koji objašnjava šta
            se dešava.
          </p>
        </div>

        <div class="grid gap-10 lg:grid-cols-[1.1fr_1fr]">
          <!-- broadcast frame mockup -->
          <div
            class="relative aspect-[16/9] overflow-hidden rounded-xl border border-[#1a2e1a] bg-[#060a06]"
          >
            <video
              autoplay
              loop
              muted
              playsinline
              class="h-full w-full object-contain"
            >
              <source src={`${BASE}ZenCarpOverlay.mp4`} type="video/mp4" />
            </video>
          </div>

          <!-- feed list -->
          <div class="divide-y divide-[#1a2e1a]">
            {
              liveFeed.map((f) => (
                <div class="flex items-start gap-4 py-4">
                  <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-[#c9a227]" />
                  <div>
                    <div
                      class={`text-sm font-medium tracking-[0.1em] text-[#e8e8e8] uppercase ${fontData}`}
                    >
                      {f.title}
                    </div>
                    <div class="mt-1 text-[13px] leading-relaxed text-[#888]">
                      {f.desc}
                    </div>
                  </div>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <!-- MOBILE -->
    <section id="mobile" class="reveal px-5 py-24">
      <div class="mx-auto grid max-w-6xl items-center gap-14 lg:grid-cols-2">
        <div class="order-2 lg:order-1">
          <div
            class={`mb-4 text-xs font-semibold uppercase tracking-[0.25em] text-[#c9a227] ${fontData}`}
          >
            U tvom džepu
          </div>
          <h2
            class={`mb-6 text-3xl font-bold leading-tight text-[#f0f0f0] sm:text-4xl ${fontHeading}`}
          >
            Turnir na dlanu.
          </h2>
          <p class="mb-6 max-w-md text-[15px] leading-relaxed text-[#aaa]">
            Plasman želimo da učinimo dostupnim i van jezera — kroz aplikaciju
            koja bi pratila pozicije ekipa i svaki ulov čim se riba izmeri.
          </p>
          <ul class="space-y-2 text-sm text-[#999]">
            <li class="flex items-center gap-2">
              <span class="h-1 w-1 rounded-full bg-[#c9a227]"></span>Plasman po
              težini ulova
            </li>
            <li class="flex items-center gap-2">
              <span class="h-1 w-1 rounded-full bg-[#c9a227]"></span>Istorija
              ulova po ekipama
            </li>
            <li class="flex items-center gap-2">
              <span class="h-1 w-1 rounded-full bg-[#c9a227]"></span>Ažuriranje
              čim se ulov potvrdi
            </li>
          </ul>
        </div>

        <div class="order-1 flex justify-center lg:order-2">
          <div
            class="relative w-[320px] overflow-hidden rounded-[2.5rem] border-4 border-[#111a11] bg-[#0a0f0a] shadow-2xl shadow-black/50 sm:w-[360px] lg:w-[400px]"
          >
            <div
              class="absolute top-0 left-1/2 z-10 h-6 w-32 -translate-x-1/2 rounded-b-2xl bg-[#111a11]"
            >
            </div>

            <video
              src={`${BASE}ZenCarpPhone.mp4`}
              loop
              muted
              playsinline
              autoplay
              class="aspect-[9/16] h-auto w-full object-cover"></video>
          </div>
        </div>
      </div>
    </section>

    <!-- COMPETITION / LEADERBOARD -->
    <section
      id="competition"
      class="reveal border-y border-[#111a11] bg-[#080c08] px-5 py-24"
    >
      <div class="mx-auto max-w-4xl">
        <div class="mb-4 flex items-center justify-between">
          <div
            class={`text-xs font-semibold uppercase tracking-[0.25em] text-[#c9a227] ${fontData}`}
          >
            Primer plasmana
          </div>
          <div
            class={`text-[10px] uppercase tracking-[0.2em] text-[#666] ${fontData}`}
          >
            Primer prikaza iz prenosa
          </div>
        </div>
        <h2
          class={`mb-12 text-3xl font-bold leading-tight text-[#f0f0f0] sm:text-4xl ${fontHeading}`}
        >
          Svaki ulov pomera tabelu.
        </h2>

        <div class="space-y-3">
          {
            leaderboard.map((t, i) => (
              <div class="leaderboard-row grid grid-cols-[3rem_1fr_5rem] items-center gap-4 sm:grid-cols-[3.5rem_1fr_6rem]">
                <div
                  class={`text-2xl font-semibold text-[#c9a227] ${fontData}`}
                >
                  {t.pos}
                </div>
                <div class="h-9 overflow-hidden rounded bg-[#0a0f0a]">
                  <div
                    class="bar h-full rounded bg-gradient-to-r from-[#8a6d1c] to-[#c9a227]"
                    style={`--bar-width:${Math.round((t.weight / maxWeight) * 100)}%`}
                  />
                </div>
                <div
                  class={`text-right text-sm font-medium text-[#e8e8e8] ${fontData}`}
                >
                  {t.weight.toFixed(1)} KG
                </div>
              </div>
            ))
          }
        </div>
        <p class="mt-8 text-sm leading-relaxed text-[#777]">
          Pobeđuje ekipa sa najvećom ukupnom težinom ulova. Nema poena ni
          hendikepa — plasman se menja čim se ulov potvrdi na vagi.
        </p>
      </div>
    </section>

    <!-- CONTENT / SOCIAL -->
    <section class="reveal py-24">
      <div class="mx-auto max-w-6xl px-5">
        <div class="mb-10 max-w-2xl">
          <div
            class={`mb-4 text-xs font-semibold uppercase tracking-[0.25em] text-[#c9a227] ${fontData}`}
          >
            Više od jezera
          </div>
          <h2
            class={`mb-5 text-3xl font-bold leading-tight text-[#f0f0f0] sm:text-4xl ${fontHeading}`}
          >
            Turnir se nastavlja i kad jezero utihne.
          </h2>
          <p class="text-[15px] leading-relaxed text-[#999]">
            Želimo da ZenCarp ne bude samo prenos uživo, već čitav dan
            snimljenog materijala — pozicije, izjave i ulovi koji posle mogu da
            se dele na društvenim mrežama.
          </p>
        </div>
      </div>
      <div class="overflow-hidden border-y border-[#111a11] bg-[#0a0f0a] py-5">
        <div
          class={`ticker-reverse flex w-max gap-12 whitespace-nowrap text-sm font-medium uppercase tracking-[0.2em] text-[#555] ${fontData}`}
        >
          {
            [...Array(2)].map(() =>
              contentFormats.map((c) => (
                <span class="flex items-center gap-12">
                  {c}
                  <span class="text-[#c9a227]">●</span>
                </span>
              ))
            )
          }
        </div>
      </div>
    </section>

    <!-- SPONSORS -->
    <section
      id="sponsors"
      class="reveal border-y border-[#111a11] bg-[#080c08] px-5 py-24"
    >
      <div class="mx-auto max-w-4xl text-center">
        <div
          class={`mb-4 text-xs font-semibold uppercase tracking-[0.25em] text-[#c9a227] ${fontData}`}
        >
          Partnerstvo
        </div>
        <h2
          class={`mb-6 text-3xl font-bold leading-tight text-[#f0f0f0] sm:text-4xl ${fontHeading}`}
        >
          Prostor za brend u okviru turnira.
        </h2>
        <p
          class="mx-auto mb-10 max-w-xl text-[15px] leading-relaxed text-[#aaa]"
        >
          ZenCarp planira prenos uživo, praćenje rezultata u realnom vremenu i
          sadržaj za društvene mreže. Partnerima želimo da ponudimo vidljivost
          kroz sve ove kanale, od samog starta projekta.
        </p>

        <div class="mb-10 flex flex-wrap justify-center gap-3">
          {
            sponsorTouchpoints.map((t) => (
              <span
                class={`rounded-full border border-[#1a2e1a] px-4 py-1.5 text-xs tracking-[0.1em] text-[#c9a227] uppercase ${fontData}`}
              >
                {t}
              </span>
            ))
          }
        </div>

        <a
          href="mailto:partnerstvo@zencarp.rs"
          class={`inline-flex items-center gap-2 rounded-full bg-[#c9a227] px-8 py-3.5 text-sm font-medium text-[#0a0f0a] transition-colors hover:bg-[#d4b43a] ${fontHeading}`}
        >
          Postani partner
        </a>
      </div>
    </section>

    <!-- AUDIENCE -->
    <section class="reveal px-5 py-24">
      <div class="mx-auto max-w-4xl">
        <div
          class={`mb-4 text-xs font-semibold uppercase tracking-[0.25em] text-[#c9a227] ${fontData}`}
        >
          Za koga je ovo
        </div>
        <h2
          class={`mb-6 max-w-2xl text-3xl font-bold leading-tight text-[#f0f0f0] sm:text-4xl ${fontHeading}`}
        >
          Ne moraš da pecaš da bi pratio.
        </h2>
        <p class="mb-8 max-w-xl text-[15px] leading-relaxed text-[#aaa]">
          Ulaz je besplatan i svi su dobrodošli da gledaju uživo na licu mesta —
          ima parkinga, deca su dobrodošla, a komentar je zamišljen tako da ga
          razume i neko ko nikad nije držao štap u ruci. Isti plasman moći će da
          se prati i od kuće.
        </p>
        <div class="flex flex-wrap gap-3">
          {
            audienceTags.map((tag) => (
              <span class="rounded-full bg-[#0a0f0a] px-4 py-1.5 text-xs text-[#999]">
                {tag}
              </span>
            ))
          }
        </div>
      </div>
    </section>

    <!-- EVENT INFO -->
    <section
      id="info"
      class="reveal border-y border-[#111a11] bg-[#080c08] px-5 py-24"
    >
      <div class="mx-auto max-w-3xl">
        <div
          class={`mb-4 text-xs font-semibold uppercase tracking-[0.25em] text-[#c9a227] ${fontData}`}
        >
          Podaci o turniru
        </div>
        <h2
          class={`mb-10 text-3xl font-bold leading-tight text-[#f0f0f0] sm:text-4xl ${fontHeading}`}
        >
          Detalji turnira.
        </h2>
        <div class="divide-y divide-[#1a2e1a] border-y border-[#1a2e1a]">
          {
            eventInfo.map((row) => (
              <div class="flex items-center justify-between py-4">
                <span
                  class={`text-xs tracking-[0.2em] text-[#777] uppercase ${fontData}`}
                >
                  {row.label}
                </span>
                <span class="text-[15px] font-medium text-[#e8e8e8]">
                  {row.value}
                </span>
              </div>
            ))
          }
        </div>
        <p class="mt-6 text-xs text-[#666]">
          Kompletna pravila i način bodovanja nalaze se u <a
            href={`${BASE}pravilnik`}
            class="text-[#c9a227] underline underline-offset-4 hover:text-[#e8c94a]"
            >pravilniku takmičenja</a
          >.
        </p>
      </div>
    </section>

    <!-- FINAL CTA -->
    <section id="enter" class="reveal relative overflow-hidden px-5 py-28">
      <div
        class="absolute inset-0 bg-gradient-to-b from-[#080c08] to-[#060a06]"
      >
      </div>
      <div class="relative mx-auto max-w-3xl text-center">
        <div
          class={`mb-4 text-xs font-semibold uppercase tracking-[0.25em] text-[#c9a227] ${fontData}`}
        >
          Sledeći turnir
        </div>
        <h2
          class={`mb-4 text-3xl font-bold leading-tight text-[#f0f0f0] sm:text-5xl ${fontHeading}`}
        >
          Pridruži se prvom ZenCarp turniru.
        </h2>
